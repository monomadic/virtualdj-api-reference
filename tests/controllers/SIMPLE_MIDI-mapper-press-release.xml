<?xml version="1.0" encoding="UTF-8"?>
<!-- Button lifetime fixture. One physical button, read between note-on and
     note-off, answers three things the HTTP channel cannot:

       $codex_fires  counts invocations, so press-only and press+release differ
       $codex_while  is set by a trailing `while_pressed`, so a read during the
                     hold shows whether it applies, and a read after release
                     shows whether it reverts

     If `while_pressed` binds the whole chain rather than its own statement,
     $codex_fires reverts too — that outcome is equally readable. -->
<mapper device="SIMPLE_MIDI_0_0" author="Local test fixture" version="850">
  <map value="ONINIT" action="set '$codex_loaded' 9598" />
  <map value="CODEX_PROBE_BUTTON" action="set '$codex_fires' +1 &amp; set '$codex_while' 1 while_pressed" />
  <map value="CODEX_PROBE_SLIDER" action="set '$codex_device_slider'" />
</mapper>
