{
  "description": "Follow-up to the frozen boundary run, with new values and quoted forms; no universal whitespace rule.",
  "cases": [
    {
      "id": "boundary-confirm-integer-tab",
      "fixture": "parser_constants",
      "group": "boundary-confirmation",
      "hypothesis": "Does tab after a space following 53 leave the original rendered value, unlike the calculation without that byte?",
      "script": "constant 53 \t & param_cast float & param_add 9",
      "expected": "53",
      "controls": [
        "constant 53zzboundary_a & param_cast float & param_add 9",
        "constant 53zzboundary_b & param_cast float & param_add 9"
      ],
      "contrasts": [
        {
          "script": "constant 53 & param_cast float & param_add 9",
          "expected": "62"
        },
        {
          "script": "constant 83",
          "expected": "83"
        }
      ],
      "binary_sites": [
        "IAction::stringGetParam@0x10059961c",
