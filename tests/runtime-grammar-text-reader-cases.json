{
  "description": "Sentinel-controlled get_text interpolation, result formatting and escape questions.",
  "cases": [
    {
      "id": "text-reader-paired",
      "fixture": "parser_constants",
      "group": "text-reader",
      "hypothesis": "Does paired interpolation insert the integer between literal sentinels?",
      "binary_sites": [
        "actionGetText@0x100423013",
        "actionGetText@0x1004230c1",
        "actionGetText@0x100423462",
        "actionGetText@0x1004235d8"
      ],
      "script": "get_text 'A`constant 37`B'",
      "expected": "A37B",
      "controls": [
        "get_text 'A`zzqqx`B'",
        "get_text 'A`vfnrbq`B'"
      ],
      "contrasts": [
        {
          "script": "get_text 'A`constant 83`B'",
          "expected": "A83B"
        }
      ],
      "scope": "Exact whitespace-preserving HTTP text in parser_constants. No skin rendering, outer-token escape rule, cache branch or universal result-type claim."
    },
