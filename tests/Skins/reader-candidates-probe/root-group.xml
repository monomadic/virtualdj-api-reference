  <panel name="main" visible="yes">
    <square color="#11151A">
      <pos x="0" y="0"/>
      <size width="900" height="560"/>
    </square>
    <grabzone x="0" y="0" width="900" height="40"/>

    <textzone>
      <pos x="24" y="12"/>
      <size width="852" height="20"/>
      <text font="arial" size="14" weight="bold" color="#E7EEF7" align="left" format="ZZ Reader root-group"/>
