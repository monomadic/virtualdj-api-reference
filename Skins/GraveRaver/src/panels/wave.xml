<?xml version="1.0" encoding="UTF-8"?>
<module>
  <panel name="wave_main" visible="yes">
    <group name="wave_root" x="0" y="500">
      <square color="yellow">
        <pos x="+0" y="+0"/>
        <size width="1920" height="200"/>
      </square>
      <scratchwave orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="leftdeck">
        <pos x="0" y="+20"/>
        <size width="1920" height="200"/>
        <grid height="10" pos="-18" maincolor="#888888" size="1" mainsize="1" phrasecolor="white" phrasesize="1" color="transparent" shapepos="-14"/>
        <gridlines width="1" color="gridlines" transparency="0.3"/>
        <cue y="-16">
          <mask x="123" y="100" width="6" height="13"/>
          <text dx="+8" dy="-1" fontsize="12" important="true"/>
        </cue>
        <!-- <overlay> -->
        <!-- <pos x="941" y="+0"/> -->
        <!-- <size width="4" height="[HEIGHT]/5"/> -->
        <!-- <background color="needle" shape="square"/> -->
        <!-- </overlay> -->
      </scratchwave>
      <!-- <line color="wave_grid" width="1"> -->
      <!-- <pos x="+740" y="+0"/> -->
      <!-- <pos2 x="+740" y="+220"/> -->
      <!-- </line> -->
      <textzone class="label_small">
        <pos x="+12" y="+10"/>
        <size width="120" height="18"/>
        <text fontsize="11" color="text_dim" align="left" text="WAVEFORM"/>
      </textzone>
      <!-- put your actual waveform element(s) here -->
      <!-- e.g. scratch wave / rhythm wave / stacked deck waves -->
      <!-- playhead overlay if needed -->
      <line color="wave_playhead" width="2">
        <pos x="+740" y="+20"/>
        <pos2 x="+740" y="+200"/>
      </line>
    </group>
  </panel>
</module>
