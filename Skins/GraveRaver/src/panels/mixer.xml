<?xml version="1.0" encoding="UTF-8"?>
<module>
  <panel name="mixer_main" visible="yes">
    <group name="mixer_root" x="1920/2" y="50">
      <!-- background -->
      <square color="blue" canstretch="false">
        <pos x="1920/2-160" y="50"/>
        <size width="1920-800-800" height="400"/>
      </square>
      <textzone class="label_small">
        <pos x="+0" y="+0"/>
        <text fontsize="11" color="text_dim" align="center" text="MIXER"/>
      </textzone>
      <slider action="crossfader" orientation="horizontal">
        <pos x="+0" y="+30"/>
        <size width="240" height="24"/>
        <background color="bg_panel_alt" radius="4"/>
        <cursor>
          <size width="26" height="24"/>
          <off radius="4" border_size="1" border="button_border" color="button_bg"/>
          <over radius="4" border_size="1" border="button_border_on" color="button_bg_over"/>
        </cursor>
      </slider>
      <button class="button_main" action="crossfader_curve &amp; param_multiply 100%">
        <pos x="+0" y="+68"/>
        <size width="116" height="22"/>
        <text fontsize="11" color="button_text" align="center" text="CURVE"/>
      </button>
      <button class="button_main" action="masterdeck">
        <pos x="+124" y="+68"/>
        <size width="116" height="22"/>
        <text fontsize="11" color="button_text" align="center" text="MASTER"/>
      </button>
      <visual source="get_vu_meter" type="linear" orientation="vertical">
        <pos x="+250" y="+0"/>
        <size width="10" height="90"/>
        <off color="vu_off"/>
        <on color="vu_on"/>
      </visual>
      <visual source="master ? get_vu_meter : 0" type="linear" orientation="vertical">
        <pos x="+264" y="+0"/>
        <size width="10" height="90"/>
        <off color="vu_off"/>
        <on color="vu_on"/>
      </visual>
    </group>
  </panel>
</module>
