<?xml version="1.0" encoding="UTF-8"?>
<globals>
  <!-- Runtime skin globals and environment defaults -->
  <!-- Deck state:
    @$4decks controls whether the skin exposes 2 or 4 decks.
    @$hauntinglayout is the deck-density switch inside a mode: 0 = compact / swap, 1 = full 4-deck.
    @$hide_main_waveforms controls main-deck waveform visibility on the normal layout: 0 = show, 1 = hide.
    @$hide_zoom_waveforms controls waveform visibility in browser-zoom / mini-deck mode: 0 = show, 1 = hide.
    @$show_zoom_racks controls rack visibility in browser-zoom / mini-deck mode: 0 = hide, 1 = show.
    @$hauntingutilitybar controls whether the bottom utility bar reserves screen space.
  -->
  <font name="Helvetica Neue"/>
  <nbdecks value="2" condition="var_equal '@$4decks' 0"/>
  <nbdecks value="4" condition="var_not_equal '@$4decks' 0"/>
  <tooltip size="14" color="#e2e3e4" back="#2f2f2f" shortcut="gray" localize="true"/>
  <dialogs darkmode="true"/>
</globals>
