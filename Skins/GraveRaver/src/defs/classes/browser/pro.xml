      <over color="transparent" border="red" border_size="2" width="60" height="60"/>
      <down color="dark_3" border="browser_iconbuttonoff" border_size="2" width="60" height="60"/>
      <selected color="dark_5" border="white" border_size="2" width="60" height="60"/>
      <active color="dark_3" border="browser_iconbuttonoff" border_size="2" width="60" height="60"/>
      <menu shape="circle" color="textdarker" border="button_background2" border_size="7" width="32" height="32"/>
      <menuover shape="circle" color="green" border="button_background" border_size="7" width="32" height="32"/>
    </button>
    <fontsearch size="18"/>
    <font size="20"/>
    <fontheader size="16"/>
    <fontgridtitle size="18"/>
    <fonttoolbar size="12"/>
