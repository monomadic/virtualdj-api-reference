<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Pro 4-deck rack surface.
       This is just a mode-level wrapper around the existing rack compositions:
       extended racks when the main wave area is shown, single-height racks when it is hidden. -->
  <define class="pro_racks">
    <panel class="racks_extended" condition="var_equal '@$hide_main_waveforms' 0"/>
    <panel class="racks_single" condition="var_equal '@$hide_main_waveforms' 1"/>
  </define>
  <!-- Temporary compatibility alias while old layout references are being cleaned up -->
  <define class="htng_racks">
    <panel class="pro_racks"/>
  </define>
</defs>
