<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="wave_stack" placeholders="*width=1114,*height=164">
    <!-- with no background -->
    <scratchwave orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal">
      <pos x="+0" y="+24+2"/>
      <size width="+[WIDTH]" height="+[HEIGHT]-26-26"/>
      <mouserect x="+77" y="+0" width="+[WIDTH]-77" height="+[HEIGHT]-26-26"/>
      <grid height="10" pos="-18" maincolor="#555555" size="1" mainsize="1" phrasecolor="white" phrasesize="2" color="black" mirrored="true" shapepos="-14" shapemirrored="down"/>
      <gridlines width="1" color="gridlines" transparency="0.6"/>
      <cue y="-18" height="[HEIGHT]">
        <mask x="42" y="0" width="7" height="12"/>
        <text dx="+10" dy="-3" weight="" fontsize="14" important="true"/>
      </cue>
      <overlay>
        <pos x="+[WIDTH]/2" y="-24"/>
        <size width="2" height="+[HEIGHT]-4"/>
        <background color="needle" shape="square"/>
      </overlay>
    </scratchwave>
    <panel class="cover_art_hntg" size="[HEIGHT]" x="+[WIDTH]-[HEIGHT]" y="+0" visibility=""/>
    <!-- needle (left aligned) -->
    <panel class="beat_counter" x="+[WIDTH]/4-170" y="+22"/>
    <dropzone>
      <pos x="+77" y="+2"/>
      <size width="+[WIDTH]-77" height="+[HEIGHT]-4"/>
      <over color="transparent" border="deckcolor" border_size="2"/>
    </dropzone>
    <!-- VU levels -->
    <panel class="channel_levels_stack" x="+0"/>
    <visual class="gfx_shape" width="[WIDTH]" height="[HEIGHT]" coloroff="transparent" bordercoloroff="#333333" bordersize="1"/>
    <menu tooltip="WAVEFORM OPTIONS" visibility="0.8">
      <pos x="+77+4" y="178+164+2" condition="var_equal '@$hauntinglayout' 1"/>
      <pos x="+77+4" y="178"/>
      <size width="26" height="26"/>
      <off shape="square" color="button_background"/>
      <icon sysicon="settings" height="24" width="24" color="textoff" colorover="needle" colordown="needle"/>
      <submenu text="Waveform Type" localize="true">
        <item text="Scratch" localize="true" action="setting 'skinWaveformType' 'colors'" check="not setting 'skinWaveformType' 'shapes'"/>
        <item text="Shapes" localize="true" action="setting 'skinWaveformType' 'shapes'" check="setting 'skinWaveformType' 'shapes'"/>
      </submenu>
      <submenu text="Colors" localize="true" visibility="setting 'skinWaveformType' 'colors'">
        <item text="Monochrome" localize="true" action="setting 'coloredWaveforms' 'monochrome'" check="setting 'coloredWaveforms' 'monochrome'"/>
        <item text="Per Deck" localize="true" action="setting 'coloredWaveforms' 'per-deck'" check="setting 'coloredWaveforms' 'per-deck'"/>
        <item text="Neutral" localize="true" action="setting 'coloredWaveforms' 'neutral'" check="setting 'coloredWaveforms' 'neutral'"/>
        <item text="Infra Red" localize="true" action="setting 'coloredWaveforms' 'infra-red'" check="setting 'coloredWaveforms' 'infra-red'"/>
        <item text="Ultra Blue" localize="true" action="setting 'coloredWaveforms' 'ultra-blue'" check="setting 'coloredWaveforms' 'ultra-blue'"/>
        <separator/>
        <item text="Wave Use Frequency" action="setting 'waveUseFrequency'" check="setting 'waveUseFrequency'"/>
      </submenu>
      <submenu text="Colors" localize="true" visibility="setting 'skinWaveformType' 'shapes'">
        <item text="Virtual DJ (ish)" localize="true" action="set '@$hauntingcolorshapescolors' 0 &amp; load_skin" check="var_equal '@$hauntingcolorshapescolors' 0"/>
        <item text="Denon DJ (ish)" localize="true" action="set '@$hauntingcolorshapescolors' 2 &amp; load_skin" check="var_equal '@$hauntingcolorshapescolors' 2"/>
        <item text="Pioneer DJ (ish)" localize="true" action="set '@$hauntingcolorshapescolors' 1 &amp; load_skin" check="var_equal '@$hauntingcolorshapescolors' 1"/>
      </submenu>
      <submenu text="Needle" localize="true">
        <item text="Left" localize="true" action="setting 'waveformCenter' 'left'" check="setting 'waveformCenter' 'left'"/>
        <item text="Centered" localize="true" action="setting 'waveformCenter' 'centered'" check="setting 'waveformCenter' 'centered'"/>
      </submenu>
      <submenu text="Waveform Order" localize="true" visibility="not setting skinWaveformType 0 ? var_equal '@$hauntinglayout' 1 ? var_equal '@$4decks' 1">
        <item text="1-2-3-4" localize="true" action="setting 'mixerOrder' '1234'" check="setting 'mixerOrder' '1234'"/>
        <item text="3-1-2-4" localize="true" action="setting 'mixerOrder' '3124'" check="setting 'mixerOrder' '3124'"/>
        <item text="1-3-4-2" localize="true" action="setting 'mixerOrder' '1342'" check="setting 'mixerOrder' '1342'"/>
      </submenu>
      <separator/>
      <item text="Show Background" localize="true" action="toggle '@$hauntingwavesbkg'" check="var_equal '@$hauntingwavesbkg' 1" visibility="not setting skinWaveformType 0"/>
      <item text="Show Gridlines" localize="true" action="setting 'showGridlines'" check="setting 'showGridlines'"/>
      <item text="Bar Counter" localize="true" action="toggle '@$hauntingbarcounter'" check="var_equal '@$hauntingbarcounter' 1"/>
      <item text="Wave Gray On Kill" action="setting 'waveGrayOnKill'" check="setting 'waveGrayOnKill'" visibility="setting skinWaveformType 2"/>
    </menu>
    <menu tooltip="MIXER OPTIONS" visibility="var_equal '@$hauntingskinmixerrack' 1 ? constant 0.8">
      <pos x="+77+4" y="178+38+164+2" condition="var_equal '@$hauntinglayout' 1"/>
      <pos x="+77+4" y="178+38"/>
      <size width="26" height="26"/>
      <off shape="square" color="xf_background" border="xf_background"/>
      <icon sysicon="chevrondown" height="20" width="20" color="textdarker" colorover="needle" colordown="needle"/>
      <submenu text="Left Panel (Mixer)" localize="true">
        <item text="Microphone" action="set '@$hauntingleftmixerrack' 0" check="var_equal '@$hauntingleftmixerrack' 0"/>
        <item text="Headphones" action="set '@$hauntingleftmixerrack' 1" check="var_equal '@$hauntingleftmixerrack' 1"/>
      </submenu>
      <separator/>
      <submenu text="Right Panel (Mixer)" localize="true">
        <item text="Master" action="set '@$hauntingrightmixerrack' 0" check="var_equal '@$hauntingrightmixerrack' 0"/>
        <item text="Rec/Broadcast" action="set '@$hauntingrightmixerrack' 1" check="var_equal '@$hauntingrightmixerrack' 1"/>
      </submenu>
      <separator/>
      <submenu text="Center Panel (FX)" localize="true">
        <item text="Master FX" action="set '@$hauntingcenterfxrack' 0" check="var_equal '@$hauntingcenterfxrack' 0"/>
        <item text="Mic FX" action="set '@$hauntingcenterfxrack' 1" check="var_equal '@$hauntingcenterfxrack' 1"/>
      </submenu>
      <separator/>
      <submenu text="EQ Frequency Spread" localize="true">
        <item text="Default" action="setting 'equalizerFrequencySpread' 'default'" check="setting 'equalizerFrequencySpread' 'default'"/>
        <item text="Full Kill" action="setting 'equalizerFrequencySpread' 'full kill'" check="setting 'equalizerFrequencySpread' 'full kill'"/>
      </submenu>
      <submenu text="Vu Meter" localize="true">
        <item text="Peak Mode" action="setting 'vuMeter' 'peak'" check="setting 'vuMeter' 'peak'"/>
        <item text="Power Mode" action="setting 'vuMeter' 'power'" check="setting 'vuMeter' 'power'"/>
        <separator text="Color"/>
        <item text="Per Deck" action="set '@$hntnhvumetercolors' 0" check="var_equal '@$hntnhvumetercolors' 0"/>
        <item text="Natural" action="set '@$hntnhvumetercolors' 1" check="var_equal '@$hntnhvumetercolors' 1"/>
        <separator/>
        <item text="Show Extra Peak Meter" localize="true" action="toggle '@$hauntingshowpeaksmt'" check="var_equal '@$hauntingshowpeaksmt' 1"/>
      </submenu>
      <submenu text="Filter Resonance" localize="true">
        <item text="Default" action="setting 'filterDefaultResonance' 'default'" check="setting 'filterDefaultResonance' 'default'"/>
        <item text="Strong" action="setting 'filterDefaultResonance' 'strong'" check="setting 'filterDefaultResonance' 'strong'"/>
        <item text="Subtle" action="setting 'filterDefaultResonance' 'subtle'" check="setting 'filterDefaultResonance' 'subtle'"/>
      </submenu>
      <submenu text="Fader Start" localize="true">
        <item text="ON" action="deck all setting 'faderStart' on" check="setting 'faderStart' on"/>
        <item text="OFF" action="deck all setting 'faderStart' off" check="setting 'faderStart' off"/>
      </submenu>
      <submenu text="Fader StartStop" localize="true">
        <item text="ON" action="deck all setting 'faderStartStop' on" check="setting 'faderStartStop' on"/>
        <item text="OFF" action="deck all setting 'faderStartStop' off" check="setting 'faderStartStop' off"/>
      </submenu>
      <separator/>
      <item text="Reset EQ On Load" localize="true" action="setting 'resetEqOnLoad'" check="setting 'resetEqOnLoad'"/>
      <item text="Use Auto Gain" localize="true" action="setting 'autoGain' 'auto' ? setting 'autoGain' 'no' : setting 'autoGain' 'auto'" check="setting 'autoGain' 'auto'"/>
      <item text="Show Drop Down Menus" localize="true" action="toggle '@$hauntingdropmenus'" check="var_equal '@$hauntingdropmenus' 0"/>
    </menu>
    <group name="zoom_button" condition="var_equal '@$hauntinglayout' 0">
      <button class="button_main" x="+[WIDTH]-26-4" y="178" width="26" height="26" action="repeat 100ms &amp; zoom -0.60%" text="+" weight="bold" textcoloron="needle" coloron="button_background" bordersize="0" textsize="18" visibility="0.7"/>
      <button class="button_main" x="+[WIDTH]-26-4" y="178+38" width="26" height="26" action="repeat 100ms &amp; zoom +0.60%" text="-" weight="bold" textcoloron="needle" coloron="button_background" bordersize="0" textsize="20" visibility="0.7"/>
    </group>
    <group name="zoom_button" condition="var_equal '@$hauntinglayout' 1">
      <button class="button_main" x="+[WIDTH]-26-4" y="178+164+2" width="26" height="26" action="repeat 20ms &amp; zoom -0.60%" text="+" weight="bold" textcoloron="needle" coloron="button_background" bordersize="0" textsize="18" visibility="0.7"/>
      <button class="button_main" x="+[WIDTH]-26-4" y="178+38+164+2" width="26" height="26" action="repeat 20ms &amp; zoom +0.60%" text="-" weight="bold" textcoloron="needle" coloron="button_background" bordersize="0" textsize="20" visibility="0.7"/>
    </group>
  </define>
</defs>
