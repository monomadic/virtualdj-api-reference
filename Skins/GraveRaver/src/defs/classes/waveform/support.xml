<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="AREA_WAVES">
    <panel class="waveform" x="+2" waveformheight="381" condition="var_equal '@$infntywavesize' 13"/>
    <panel class="waveform" x="+2" waveformheight="361" condition="var_equal '@$infntywavesize' 12"/>
    <panel class="waveform" x="+2" waveformheight="341" condition="var_equal '@$infntywavesize' 11"/>
    <panel class="waveform" x="+2" waveformheight="321" condition="var_equal '@$infntywavesize' 10"/>
    <panel class="waveform" x="+2" waveformheight="301" condition="var_equal '@$infntywavesize' 9"/>
    <panel class="waveform" x="+2" waveformheight="281" condition="var_equal '@$infntywavesize' 8"/>
    <panel class="waveform" x="+2" waveformheight="261" condition="var_equal '@$infntywavesize' 7"/>
    <panel class="waveform" x="+2" waveformheight="241" condition="var_equal '@$infntywavesize' 6"/>
    <panel class="waveform" x="+2" waveformheight="221" condition="var_equal '@$infntywavesize' 5"/>
    <panel class="waveform" x="+2" waveformheight="201" condition="var_equal '@$infntywavesize' 4"/>
    <panel class="waveform" x="+2" waveformheight="181" condition="var_equal '@$infntywavesize' 3"/>
    <panel class="waveform" x="+2" waveformheight="161" condition="var_equal '@$infntywavesize' 2"/>
    <panel class="waveform" x="+2" waveformheight="141" condition="var_equal '@$infntywavesize' 1"/>
    <panel class="waveform" x="+2" waveformheight="121" condition="var_equal '@$infntywavesize' 0"/>
  </define>
  <define class="CUEMAP" placeholders="*deck,width=470,height=2" orientation="horizontal" waveform="yes" colorPlayed="black">
    <size width="[WIDTH]" height="[HEIGHT]"/>
    <wave>
      <size height="0"/>
      <pos y="+5"/>
    </wave>
    <!-- cue marker sprite styling -->
    <cues dy="0" shade="0">
      <!-- widen this to make the cue markers look like bars -->
      <size width="253" height="10"/>
      <clipmask x="0" y="100"/>
      <!-- optionally define up/down/over sprites too -->
    </cues>
  </define>
</defs>
