<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="times_bpm_key_stack">
    <visual class="gfx_shape" width="484" height="108" coloroff="infos_background" bordercoloroff="panel_background" bordersize="2"/>
    <!-- stems buttons -->
    <panel class="times_display_left_stack" x="+2+8-80" y="+2"/>
    <!-- cue buttons -->
    <panel class="prf_infopanels_left_stack" x="+2+4" y="+2+58"/>
    <panel class="transport_left_stack" x="+370" y="+2"/>
    <panel class="bpm_display_left_stack" x="+2+4+180+6+98+4-80" y="+2"/>
    <!-- <panel class="syncoptions_display" x="+2+6" y="+39" /> -->
  </define>
  <define class="times_bpm_key_stack2">
    <visual class="gfx_shape" width="484" height="108" coloroff="infos_background" bordercoloroff="panel_background" bordersize="2"/>
    <panel class="times_display_left_stack" x="+2+8-80" y="+2"/>
    <panel class="prf_infopanels_left_stack" x="+2+4" y="+2+58"/>
    <panel class="transport_left_stack" x="+370" y="+2"/>
    <panel class="bpm_display_left_stack" x="+2+4+180+6+98+4-80" y="+2"/>
    <panel class="syncoptions_display" x="+2+6" y="+39"/>
  </define>
  <define class="times_bpm_key2">
    <visual class="gfx_shape" width="404" height="104" coloroff="infos_background" bordercoloroff="panel_background" bordersize="2"/>
    <panel class="times_display_left" x="+2+4-80" y="+2" visibility="get_deck 1 ? true : get_deck 3 ? true : false"/>
    <panel class="key_display_left" x="+2+4+200+4-80" y="+2" visibility="get_deck 1 ? true : get_deck 3 ? true : false"/>
    <panel class="bpm_display_left" x="+2+4+200+4+128+4-80" y="+2" visibility="get_deck 1 ? true : get_deck 3 ? true : false"/>
    <panel class="times_display_right" x="+404-2-4-200+80" y="+2" visibility="get_deck 2 ? true : get_deck 4 ? true : false"/>
    <panel class="key_display_right" x="+404-2-4-200-4-128+80" y="+2" visibility="get_deck 2 ? true : get_deck 4 ? true : false"/>
    <panel class="bpm_display_right" x="+404-2-4-200-4-128-4-136+80" y="+2" visibility="get_deck 2 ? true : get_deck 4 ? true : false"/>
  </define>
  <define class="transport">
    <textzone x="+0" y="+0" width="36" height="46" align="center">
      <text fontsize="26" color="needle" weight="bold" deck="@">
        <action>param_div `cue_countup` `param_add cue_countup cue_countdown`</action>
      </text>
    </textzone>
    <button class="button_main" x="+0" textsize="11" y="+6" width="60" height="30" action="sampler_play_stop all" text="SAMPLER" textcolor="textoff2" coloron="button_background3" brcoloron="button_background_3" textcoloron="green"/>
    <button class="button_main" x="+0" textsize="11" y="+6+33" width="60" height="30" action="key_match_button" text="KEY" textcolor="textoff2" coloron="button_background3" brcoloron="button_background_3" textcoloron="green"/>
    <!-- <button class="button_main" x="+0" textsize="11" y="+6+30" width="60" height="30" action="key_match" text="KEY" textcolor="red" textcoloron="red" coloroff="red" coloron="red" visibility="loaded ? not masterdeck ? sync_hint"/> -->
    <button class="button_main" x="+0" textsize="11" y="+6+33+4+30" width="60" height="30" action="shift ? phrase_sync 16 : phrase_sync 32" text="PHRASE" textcolor="textoff2" textcoloron="black"/>
    <button class="button_main" x="+0" textsize="11" y="+6+33+4+28+4+31" width="60" height="30" action="sync" text="SYNC" textcolor="textoff2" textcoloron="black"/>
    <!-- <button class="button_main" x="+0" y="+6+30+4+62" width="60" height="30" action="cue_button" textaction="cue_button" textcolor="textoff2" textcoloron="black"/> -->
    <button class="button_main" x="+0" textsize="11" y="+6+33+4+30+6" width="120" height="30" action="play_pause" sysicon="play_button" iconsize="39" iconcolor="black" textcoloron="black" coloroff="button_background2"/>
  </define>
  <define class="transport_ex">
    <button class="button_main" x="+0" y="+6" width="60" height="16" action="setting 'hotcueMode' 'play'" query="setting 'hotcueMode' 'play'" textsize="11" text="CUE PLAY" coloroff="button_background3" coloron="button_background3" bordersize="0" textcolor="textoff3" textcoloron="needle"/>
    <button class="button_main" x="+0" y="+6+16+2" width="60" height="16" action="setting 'hotcueMode' 'stutter'" textsize="11" text="STUTTER" coloroff="button_background3" coloron="button_background3" bordersize="0" textcolor="textoff3" textcoloron="needle" query="slip_mode ? blink 800ms : off"/>
    <button class="button_main" x="+0" y="+6+30+4+26-8" width="60" height="30" action="sync" text="SYNC" textcolor="textoff2"/>
    <button class="button_main" x="+0" y="+6+30+4+62-8" width="60" height="30" action="cue_button" textaction="cue_button" textcolor="textoff2"/>
    <button class="button_main" x="+0" y="+6+30+4+30+6+62-8" width="60" height="30" action="play_button" sysicon="play_button" iconsize="39" textcolor="textoff2"/>
  </define>
  <define class="transport_stack">
    <button class="button_main" x="+0" y="+6" width="60" height="16" action="vinyl_mode" textsize="11" text="VINYL" coloroff="button_background3" coloron="button_background3" bordersize="0" textcolor="textoff3" textcoloron="black"/>
    <button class="button_main" x="+0" y="+6+16+2" width="60" height="16" action="slip_mode" textsize="11" text="SLIP" coloroff="button_background3" coloron="button_background3" bordersize="0" textcolor="textoff3" textcoloron="black" query="slip_mode ? blink 800ms : off"/>
    <button class="button_main" x="+0" y="+6+20+4+26" width="60" height="30" action="sync" text="SYNC" textcolor="textoff2" textcoloron="black"/>
    <button class="button_main" x="+0" y="+6+20+4+62" width="60" height="30" action="cue_button" textaction="cue_button" textcolor="textoff2" textcoloron="black"/>
    <button class="button_main" x="+0" y="+6+20+4+30+6+62" width="60" height="30" action="play_button" sysicon="play_button" iconsize="39" textcolor="textoff2" textcoloron="black"/>
  </define>
  <define class="transport_horizontal">
    <button class="button_main" x="+0" y="+0" width="64" height="30" action="sync" text="SYNC" textcolor="textoff2"/>
    <button class="button_main" x="+64+8" y="+0" width="64" height="30" action="cue_button" textaction="cue_button" textcolor="textoff2"/>
    <button class="button_main" x="+64+8+64+8" y="+0" width="64" height="30" action="play_button" sysicon="play_button" iconsize="39" textcolor="textoff2"/>
  </define>
  <define class="transport_center">
    <button class="button_main" x="+0" y="+0" width="54" height="30" action="sync" text="SYNC" textcolor="textoff2"/>
    <button class="button_main" x="+54+8" y="+0" width="54" height="30" action="cue_button" textaction="cue_button" textcolor="textoff2"/>
    <button class="button_main" x="+54+8+54+8" y="+0" width="54" height="30" action="play_button" sysicon="play_button" iconsize="39" textcolor="textoff2"/>
  </define>
  <define class="TRANSPORT_BAR" placeholders="*deck,*deckside">
    <deck deck="[DECK]">
      <!-- WARNING INDICATORS TODO: MOVE THESE -->
      <group visibility="false">
        <pos y="+2" x="+7" condition="param_equal [DECKSIDE] 'left'"/>
        <pos y="+2" x="+700" condition="param_equal [DECKSIDE] 'right'"/>
        <!-- BPM WARNING -->
        <!-- more than 20% -->
        <button action="pitch_reset 4bt" visibility="param_add `get_bpm` `get_bpm 'absolute' &amp; param_multiply -1` &amp; param_smaller -4 ? blink 500ms : off">
          <pos x="+50" y="+0"/>
          <size width="90" height="15"/>
          <off color="#000033" shape="square"/>
          <text size="14" align="center" color="blue" text="SLOW"/>
        </button>
        <button action="pitch_reset 4bt" visibility="param_add `get_bpm` `get_bpm 'absolute' &amp; param_multiply -1` &amp; param_smaller -4 ? blink 500ms : off">
          <pos x="+50" y="+15"/>
          <size width="90" height="15"/>
          <off color="#000033" shape="square"/>
          <text size="18" align="center" color="blue" weight="bold" action="get_text '%Ppitch%'"/>
        </button>
        <button action="pitch_reset 4bt" visibility="param_add `get_bpm` `get_bpm 'absolute' &amp; param_multiply -1` &amp; param_bigger 20 ? blink 500ms : off">
          <pos x="+45" y="+0"/>
          <size width="70" height="16"/>
          <off color="#330000" shape="square"/>
          <text size="14" align="center" color="red" text="FAST"/>
        </button>
        <button action="pitch_reset 4bt" visibility="param_add `get_bpm` `get_bpm 'absolute' &amp; param_multiply -1` &amp; param_bigger 20 ? blink 500ms : off">
          <pos x="+45" y="+15"/>
          <size width="70" height="16"/>
          <off color="#330000" shape="square"/>
          <text size="18" align="center" color="red" weight="bold" action="get_text '%Ppitch%'"/>
        </button>
      </group>
      <!-- SONGPOS -->
      <!-- PRO: SONGPOS -->
      <group visibility="loaded">
        <pos x="+41" y="+5" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+460" y="+5" condition="param_equal [DECKSIDE] 'right'"/>
        <!-- <songpos class="cuemap" x="+3" y="+1" width="270" height="5"/> -->
        <songpos class="songpos" x="+6" y="+6" width="300" height="16" colorPlayed="deckcolor"/>
        <visual width="310" height="27">
          <off shape="square" color="transparent" border_size="1" border="#555555" radius="4"/>
        </visual>
      </group>
      <!-- TRANSPORT BAR: SYNC BUTTONS -->
      <group visibility="loaded">
        <pos x="+365" y="+6" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+115" y="+6" condition="param_equal [DECKSIDE] 'right'"/>
        <!-- KEY BUTTON -->
        <button class="button_main" action="select &amp; match_key" bordersize="1" query="match_key ? true : blink 1bt" visibility="not masterdeck">
          <pos x="+0" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*3" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#330000" border="#FF0000" radius="3"/>
          <down color="#222222" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="#FF0000" colorselected="deckcolor" colordown="deckcolor" align="center" text="KEY"/>
        </button>
        <!-- KEY BUTTON: masterdeck -->
        <button class="button_main" action="select &amp; match_key" bordersize="1" visibility="masterdeck">
          <pos x="+0" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*3" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#000000" border="color_masterdeck" radius="3"/>
          <down color="#222222" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="color_masterdeck" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="KEY"/>
        </button>
        <!-- BEAT BUTTON -->
        <button class="button_main" action="select &amp; sync" bordersize="1" query="not play ? true : not is_sync ? blink 1bt : true" visibility="not masterdeck">
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#330000" border="#FF0000" radius="3"/>
          <down color="#222222" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="#FF0000" colorselected="deckcolor" colordown="deckcolor" align="center" text="BEAT"/>
        </button>
        <button class="button_main" action="select &amp; action_deck 1 ? deck 2 sync &amp; deck 3 sync &amp; deck 4 sync : action_deck 2 ? deck 1 sync &amp; deck 3 sync &amp; deck 4 sync : action_deck 3 ? deck 1 sync &amp; deck 2 sync &amp; deck 4 sync : deck 1 sync &amp; deck 2 sync &amp; deck 3 sync" bordersize="1" query="true" visibility="masterdeck">
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#330000" border="#FF0000" radius="3"/>
          <down color="#222222" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="#FF0000" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="BEAT"/>
        </button>
        <!-- PHRASE BUTTON -->
        <button class="button_main" x="+0" action="sync &amp; phrase_sync 32" bordersize="1" query="not play ? true : is_sync ? true : blink 1bt" visibility="not masterdeck">
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#440000" border="#FF3333" radius="3"/>
          <down color="#222222" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="#FF3333" colorselected="deckcolor" colordown="deckcolor" align="center" text="PHRASE"/>
        </button>
        <button class="button_main" x="+0" action="sync &amp; phrase_sync 32" bordersize="1" query="true" visibility="masterdeck">
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#111111" border="#333333" radius="3"/>
          <down color="#222222" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="#333333" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="PHRASE"/>
        </button>
        <!-- MASTER/SLAVE BUTTON -->
        <button class="button_main" action="select &amp; masterdeck" textcoloron="orange" bordersize="2" query="masterdeck" visibility="loaded">
          <pos x="+82*3" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+0" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="#000000" border="#888888" border_size="1" shape="square" radius="3"/>
          <down color="#000000" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
          <selected color="color_masterdeck" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
          <text size="11" dx="+0" action="masterdeck ? masterdeck_auto ? get_text 'AUTO' : get_text 'MASTER' : get_text 'SLAVE'" color="#999999" colorselected="black" align="center"/>
        </button>
      </group>
      <!-- PLAY/PAUSE BUTTON -->
      <line color="dark_6" x="+800-100" y="+0" width="1" height="38" condition="param_equal [DECKSIDE] 'left'"/>
      <line color="dark_6" x="+105" y="+0" width="1" height="38" condition="param_equal [DECKSIDE] 'right'"/>
      <!-- not master -->
      <button class="button_main" textsize="11" width="100" height="38" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0">
        <pos x="+800-100" y="+0" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+2" y="+0" condition="param_equal [DECKSIDE] 'right'"/>
        <off color="transparent" border="transparent" border_size="0" shape="square" radius="4" iconcolor="blue"/>
        <over color="transparent" border="transparent" border_size="0" shape="square" radius="4"/>
        <down color="transparent" border="transparent" border_size="0" shape="square" radius="4"/>
        <selected color="transparent" border="transparent" border_size="1" radius="4"/>
      </button>
      <button class="button_main" textsize="11" width="102" height="38" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0" visibility="not masterdeck ? play ? blink 1bt : on">
        <pos x="+800-102" y="+0" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+2" y="+0" condition="param_equal [DECKSIDE] 'right'"/>
        <off color="transparent" border="#444444" border_size="0" shape="square" radius="4"/>
        <over color="transparent" border="deckcolor" border_size="1" shape="square" radius="4"/>
        <down color="transparent" border="dark_4" border_size="0" shape="square" radius="4"/>
        <selected color="transparent" border="deckcolor" border_size="2" radius="4"/>
        <icon coloroff="deckcolor" colorover="deckcolor" colordown="#FFFFFF" colorselected="deckcolor"/>
      </button>
      <button class="button_main" textsize="11" width="100" height="38" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0" visibility="masterdeck ? play ? blink 1bt : on">
        <pos x="+800-100" y="+0" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+2" y="+0" condition="param_equal [DECKSIDE] 'right'"/>
        <off color="transparent" border="color_masterdeck" border_size="0" shape="square" radius="4" iconcolor="blue"/>
        <over color="transparent" border="color_masterdeck" border_size="1" shape="square" radius="4"/>
        <down color="transparent" border="#888888" border_size="0" shape="square" radius="4"/>
        <selected color="transparent" border="color_masterdeck" border_size="2" radius="4"/>
        <icon coloroff="color_masterdeck" colorover="color_masterdeck" colordown="#888888" colorselected="color_masterdeck"/>
      </button>
    </deck>
  </define>
</defs>
