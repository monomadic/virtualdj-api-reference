<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="JOGWHEEL_CORNER_BUTTONS" placeholders="*jogsize=155">
    <group>
      <!-- <visual> -->
      <!-- <size width="24" height="24"/> -->
      <!-- <pos x="-2" y="-2"/> -->
      <!-- <off shape="circle" color="#111111" border="#000000" border_size="1"/> -->
      <!-- </visual> -->
      <visual>
        <size width="20" height="20"/>
        <off shape="circle" color="#333333" border="#222222" border_size="1"/>
      </visual>
      <button action="auto_sync_options" query="auto_match_bpm ? auto_match_key ? auto_sync ? auto_pitch_lock" visibility="loaded" shape="circle">
        <size width="10" height="10"/>
        <pos x="+5" y="+5"/>
        <off shape="circle" color="#AAAAAA" border="#000000" border_size="1"/>
        <selected shape="circle" color="#00FF00" border="#222222" border_size="1"/>
        <over shape="circle" color="#DDDDDD" border="#000000" border_size="0"/>
        <down shape="circle" color="#00FF00" border="#88FFFF00" border_size="0"/>
      </button>
    </group>
    <group x="+[JOGSIZE]-20" y="+0">
      <visual>
        <size width="20" height="20"/>
        <off shape="circle" color="#333333" border="#222222" border_size="1"/>
        <over shape="circle" color="#888888" border="#888888" border_size="1"/>
      </visual>
      <!-- PRO: JOGWHEEL MENU -->
      <menu>
        <pos x="+5" y="+5"/>
        <size width="10" height="10"/>
        <pos x="+5" y="+5"/>
        <icon sysicon="settings" height="18" width="18" color="#AAAAAA" colorover="white" colordown="needle"/>
        <item text="Needle" localize="true" action="set '@$hauntingjogtype' 0" check="var_equal '@$hauntingjogtype' 0"/>
        <item text="Text" localize="true" action="set '@$hauntingjogtype' 1" check="var_equal '@$hauntingjogtype' 1"/>
        <item text="Sync Status" localize="true" action="set '@$hauntingjogtype' 2" check="var_equal '@$hauntingjogtype' 2"/>
        <item text="Cover Art" localize="true" action="set '@$hauntingjogtype' 3" check="var_equal '@$hauntingjogtype' 3"/>
        <separator localize="true"/>
        <submenu text="Text" localize="true">
          <item text="Jog Mode" localize="true" action="set '@$haunting_jog_text' 0" check="var_equal '@$haunting_jog_text' 0"/>
          <item text="Loop Size" localize="true" action="set '@$haunting_jog_text' 1" check="var_equal '@$haunting_jog_text' 1"/>
          <item text="Elapsed" localize="true" action="set '@$haunting_jog_text' 2" check="var_equal '@$haunting_jog_text' 2"/>
          <item text="Remain" localize="true" action="set '@$haunting_jog_text' 3" check="var_equal '@$haunting_jog_text' 3"/>
        </submenu>
        <submenu text="RPM" localize="true">
          <item text="25" localize="true" action="setting 'RPM' 25" check="setting 'RPM' 25"/>
          <item text="33" localize="true" action="setting 'RPM' 33" check="setting 'RPM' 33"/>
          <item text="45" localize="true" action="setting 'RPM' 45" check="setting 'RPM' 45"/>
          <item text="4 Beats" localize="true" action="setting 'RPM' '4 beats'" check="setting 'RPM' '4 beats'"/>
        </submenu>
        <separator localize="true"/>
        <item text="Auto Disc Marker" action="setting 'autoDiscMarker'" check="setting 'autoDiscMarker'"/>
      </menu>
    </group>
  </define>
  <define class="JOGWHEEL" placeholders="*jogsize=155">
    <!-- JOGWHEEL A: NEEDLE -->
    <group name="jogwheel_a" visibility="var_equal '@$hauntingjogtype' 0">
      <visual novisibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
      </visual>
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
        <on shape="circle" color="knobfillon"/>
      </visual>
      <visual name="innercircle_border">
        <pos x="+6" y="+6"/>
        <size width="[JOGSIZE]-12" height="[JOGSIZE]-12"/>
        <off shape="circle" color="jogprogressoff" border_size="35" border="jogwheelbackground"/>
      </visual>
      <!-- SONG ENDING WARNING -->
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink" tooltip="">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/>
        <on border_size="5" border="deckcolor" color="mixerbackground" shape="circle"/>
      </visual>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="deckcolor" widthfader="14" heightfader="32" radius="42"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jog_slider" widthfader="14" heightfader="32" radius="42"/>
      <visual name="innercircle_border" visibility="loaded">
        <pos x="+52" y="+52"/>
        <size width="[JOGSIZE]-104" height="[JOGSIZE]-104"/>
        <off shape="circle" color="jogprogressoff" border_size="7" border="deckcolor"/>
      </visual>
      <visual name="innercircle_border">
        <pos x="+69" y="+69"/>
        <size width="[JOGSIZE]-69-69" height="[JOGSIZE]-69-69"/>
        <off shape="circle" color="deckcolor" border_size="0" border="jogprogressoff"/>
      </visual>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="jogprogressoff" widthfader="8" heightfader="16" radius="14"/>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="deckcolor" widthfader="6" heightfader="34" radius="35"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="jog_slider" widthfader="5" heightfader="5" radius="69"/>
      <panel class="jogwheel_corner_buttons"/>
    </group>
    <!-- JOGWHEEL B: TEXT -->
    <group name="jogwheel_b" visibility="var_equal '@$hauntingjogtype' 1">
      <visual>
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
      </visual>
      <!-- SONG ENDING WARNING -->
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink" tooltip="" visibility="songpos_warning ? blink 1bt">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="red" shape="circle"/>
        <on border_size="5" border="deckcolor" color="mixerbackground" shape="circle"/>
      </visual>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="deckcolor" widthfader="14" heightfader="32" radius="42"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jog_slider" widthfader="14" heightfader="32" radius="42"/>
      <visual name="innercircle_border">
        <pos x="+10" y="+10"/>
        <size width="[JOGSIZE]-20" height="[JOGSIZE]-20"/>
        <off shape="circle" color="jogwheelbackground2" border_size="1" border="deckcolor"/>
      </visual>
      <textzone class="text" x="+18" y="+28" width="[JOGSIZE]-36" height="46" fontsize="26" color="needle" align="center" weight="bold" textaction="var_equal '@$hauntingbpmhideopt' 1 ? get_text '--.--' : var_equal '@$hauntingjogbpmdgts' 0 ? get_text '%Pbpm' : var_equal '@$hauntingjogbpmdgts' 1 ? get_text '%Pbpmex'"/>
      <button class="button_main" action="key_match_button" width="50" height="16" x="+18+6" y="+72" coloroff="button_background" bordersize="0" textsize="12" textcolor="textdarker" text="KEY" visibility="loaded ? key 0"/>
      <button class="button_main" action="key_match_button" width="50" height="16" x="+18+6" y="+72" coloroff="button_background" bordersize="0" textsize="14" textcolor="textoff2" textaction="get_key_modifier_text" visibility="loaded ? not key 0"/>
      <button class="button_main" width="50" height="16" x="+18+6+50" y="+72" coloroff="transparent" coloron="transparent" bordersize="0" textsize="14" textcolor="textoff2" textaction="get_text '±%Ppitchrange'" visibility="loaded"/>
      <textzone class="text" x="+18" y="+92" width="[JOGSIZE]-36" height="26" fontsize="14" color="deckcolor" align="center" weight="" textaction="wheel_mode &amp; param_uppercase" visibility="loaded ? var_equal '@$haunting_jog_text' 0"/>
      <button class="button_main" x="+18" y="+92" width="[JOGSIZE]-36" height="26" action="loop" textsize="14" coloroff="transparent" coloron="transparent" bordersize="0" align="center" weight="bold" textaction="get_text '`get_loop` LOOP'" visibility="loaded ? var_equal '@$haunting_jog_text' 1"/>
      <textzone class="text" x="+18" y="+92" width="[JOGSIZE]-36" height="26" fontsize="18" color="texton2" align="center" weight="" textaction="get_time 'elapsed'" visibility="loaded ? var_equal '@$haunting_jog_text' 2"/>
      <textzone class="text" x="+18" y="+92" width="[JOGSIZE]-36" height="26" fontsize="18" color="texton2" align="center" weight="" textaction="get_time 'remain'" visibility="loaded ? var_equal '@$haunting_jog_text' 3"/>
      <panel class="jogwheel_corner_buttons"/>
    </group>
    <!-- JOGWHEEL C: SYNC STATUS -->
    <group name="jogwheel_c" visibility="var_equal '@$hauntingjogtype' 2">
      <visual novisibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
      </visual>
      <!-- outer progress ring -->
      <visual source="song_pos" type="circle" visibility="not masterdeck">
        <tooltip/>
        <pos x="-1" y="-1"/>
        <size width="[JOGSIZE]+2" height="[JOGSIZE]+2"/>
        <off shape="circle" color="#333333" border="transparent"/>
        <on shape="circle" color="deckcolor" border="transparent"/>
      </visual>
      <visual source="song_pos" type="circle" visibility="masterdeck">
        <tooltip/>
        <pos x="-1" y="-1"/>
        <size width="[JOGSIZE]+2" height="[JOGSIZE]+2"/>
        <off shape="circle" color="#333333" border="transparent"/>
        <on shape="circle" color="color_masterdeck" border="transparent"/>
      </visual>
      <!-- song end warning -->
      <visual source="song_pos" type="circle" visibility="songpos_warning ? blink 1bt">
        <pos x="-1" y="-1"/>
        <size width="[JOGSIZE]+2" height="[JOGSIZE]+2"/>
        <off shape="circle" color="red" border="red"/>
        <on shape="circle" color="#DDFFAAAA" border="red"/>
      </visual>
      <!-- time spinner -->
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="#222222" widthfader="10" heightfader="50" radius="30"/>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="#DDDDDD" widthfader="5" heightfader="50" radius="28"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="jog_slider" widthfader="8" heightfader="8" radius="66"/>
      <!-- WARNING: SONG POS -->
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded" color="red" width="40" height="40" x="+0" y="+0"/>
      <!-- black circle mask -->
      <visual name="innercircle_border">
        <pos x="+10" y="+10"/>
        <size width="[JOGSIZE]-20" height="[JOGSIZE]-20"/>
        <off shape="circle" color="jogwheelbackground2"/>
      </visual>
      <visual name="innercircle_border" visibility="songpos_warning ? blink 1bt">
        <pos x="+10" y="+10"/>
        <size width="[JOGSIZE]-20" height="[JOGSIZE]-20"/>
        <off shape="circle" color="#44FF0000"/>
      </visual>
      <group name="jogwheel_content" visibility="loaded">
        <group>
          <!-- BPM % DIFF -->
          <textzone>
            <pos x="+0" y="+12"/>
            <size width="+[JOGSIZE]" height="25"/>
            <text fontsize="12" weight="" color="white" align="center" format="`get_text '%Ppitch%'`" important="true"/>
          </textzone>
          <!-- BPM -->
          <button action="pitch_reset 8bt" x="+0" y="+36" width="[JOGSIZE]" height="22" border_size="1" border="red">
            <text fontsize="24" coloron="red" colorselected="green" weight="bold" align="center" action="var_equal '@$hauntingbpmhideopt' 1 ? get_text '--.--' : var_equal '@$hauntingjogbpmdgts' 0 ? get_text '%Pbpm' : get_text '%Pbpmex'"/>
          </button>
          <!-- LABEL: BPM -->
          <!-- <textzone> -->
          <!-- <pos x="+0" y="+7"/> -->
          <!-- <size width="[JOGSIZE]" height="25"/> -->
          <!-- <text fontsize="8" weight="" color="white" align="center" text="BPM" important="true"/> -->
          <!-- </textzone> -->
          <!-- <line x="+6" y="+58" color="white" shadow="transparent" width="146"/> -->
        </group>
        <!-- BPM- -->
        <!-- <button class="button_main" x="+27" y="+42" width="26" height="16" action="pitch -1 bpm" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="minus"/> -->
        <!-- BPM+ -->
        <!-- <button class="button_main" x="+102" y="+42" width="26" height="16" action="pitch +1 bpm" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/> -->
        <!-- PRO: JOGWHEEL: KEY BEAT PHRASE INDICATORS -->
        <group x="+8" y="+60">
          <button class="button_main" action="sync" width="43" height="18" x="+16" color="blue" coloroff="transparent" brcoloroff="red" brcoloron="green" coloron="black" bordersize="1" textsize="12" textcolor="red" textcoloron="green" text="BEAT" query="is_sync" visibility="loaded ? not masterdeck ? not is_sync ? blink 1bt : true"/>
          <button class="button_main" action="sync &amp; phrase_sync 32" width="66" height="18" x="+60" color="blue" coloroff="transparent" brcoloroff="red" brcoloron="green" coloron="black" bordersize="1" textsize="12" textcolor="red" textcoloron="green" text="PHRASE" query="is_sync" visibility="loaded ? not masterdeck ? not is_sync ? blink 1bt : true"/>
          <button class="button_main" action="key_match_button" width="110" height="18" x="+16" y="+20" coloroff="black" coloron="transparent" brcoloroff="red" brcoloron="green" brcolorover="white" bordersize="1" textsize="12" textcolor="red" textcoloron="green" text="KEY" visibility="loaded ? not masterdeck ? not key_match ? blink 1bt : true" radius="2"/>
        </group>
        <!-- MASTER BUTTON -->
        <button class="button_main" action="key_match_button" width="110" height="30" x="+16+6" y="+63" coloroff="transparent" coloron="transparent" bordersize="1" brcoloroff="orange" brcoloron="orange" radius="1" textsize="12" textcolor="orange" textcoloron="orange" textaction="masterdeck ? masterdeck_auto ? get_text 'AUTO' : get_text 'MASTER' : get_text 'SLAVE'" visibility="loaded ? masterdeck"/>
        <!-- KEY -->
        <group x="+20" y="+103">
          <!-- KEY TEXT -->
          <textzone class="text" x="+19" y="+0" width="128-26-26" height="20" action="key_match" rightclick="key_match_menu" fontsize="20" color="white" align="center" weight="bold" textaction="get_key"/>
          <!-- KEY DOWN BUTTON -->
          <button class="button_main" x="+8" y="+0" width="30" height="20" action="key_move -1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" border="0" iconsize="15" sysicon="minus" iconcolor="green"/>
          <!-- KEY MATCH BUTTON -->
          <button class="button_main" action="key_match" rightclick="key_match_menu" width="100-26-26" height="14" x="+32" y="+21" coloroff="black" coloron="black" bordersize="0" textsize="12" textcolor="red" textcoloron="green" textaction="get_key_modifier">
            <over color="red"/>
            <text coloroff="red" colorover="black"/>
          </button>
          <!-- KEY UP BUTTON -->
          <button class="button_main" x="+75" y="+0" width="30" height="20" action="key_move +1" textcoloroff="transparent" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/>
          <!-- KEY MISMATCH WARNING -->
          <!-- <visual type="square" x="+10" y="+40" width="10" height="10" color="red" visibility="not is_sync ? blink : false"/> -->
        </group>
        <panel class="jogwheel_corner_buttons"/>
      </group>
    </group>
    <!-- PRO: JOGWHEEL D: COVER ART -->
    <group name="jogwheel_d" visibility="var_equal '@$hauntingjogtype' 3">
      <!-- <visual > -->
      <!-- <tooltip/> -->
      <!-- <pos x="+0" y="+0"/> -->
      <!-- <size width="[JOGSIZE]" height="[JOGSIZE]"/> -->
      <!-- <off shape="circle" color="deckcolor" border="jogprogressoff"/> -->
      <!-- </visual> -->
      <!-- <visual x="-1" y="-1" tooltip=""> -->
      <!-- <size width="[JOGSIZE]" height="[JOGSIZE]"/> -->
      <!-- <off border_size="2" border="transparent" color="orange" shape="circle"/> -->
      <!-- <on border_size="7" border="jogprogressoff" color="orange" shape="circle"/> -->
      <!-- </visual> -->
      <!-- <visual name="outerborder" x="+0" y="+0" source="true"> -->
      <!-- <size width="[JOGSIZE]" height="[JOGSIZE]"/> -->
      <!-- <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/> -->
      <!-- <on  border_size="7" -->
      <!-- border="orange" -->
      <!-- color="mixerbackground" -->
      <!-- shape="circle"/> -->
      <!-- </visual> -->
      <visual name="innercircle_border">
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogwheelbackground2" border_size="10" border="jogprogressoff"/>
      </visual>
      <!-- <visual name="outerborder" x="+0" y="+0" source="true"> -->
      <!-- <size width="[JOGSIZE]" height="[JOGSIZE]"/> -->
      <!-- <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/> -->
      <!-- <on  border_size="7" -->
      <!-- border="orange" -->
      <!-- color="mixerbackground" -->
      <!-- shape="circle"/> -->
      <!-- </visual> -->
      <group visibility="0.6">
        <visual name="outerborder" x="+0" y="+0" source="masterdeck" query="masterdeck">
          <size width="[JOGSIZE]" height="[JOGSIZE]"/>
          <off border_size="1" border="dark_5" color="transparent" shape="circle"/>
          <on border_size="1" border="color_masterdeck" color="black" shape="circle"/>
        </visual>
      </group>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jogprogressoff" widthfader="20" heightfader="32" radius="42"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jog_slider" widthfader="20" heightfader="32" radius="42"/>
      <!-- base (yours) -->
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/>
        <on border_size="7" border="jogprogressoff" color="mixerbackground" shape="circle"/>
      </visual>
      <!-- overlay: orange border only when THIS deck is the master/sync master -->
      <!-- <visual name="outerborder_master" x="+0" y="+0" -->
      <!-- visibility="param_equal 'get_deck' 'get_activedeck'"> -->
      <!-- <size width="[JOGSIZE]" height="[JOGSIZE]"/> -->
      <!-- draw only a border (transparent fill) -->
      <!-- <off border_size="7" border="orange" color="transparent" shape="circle"/> -->
      <!-- </visual> -->
      <cover rotate="yes" visibility="0.9">
        <pos x="+12" y="+12"/>
        <size width="[JOGSIZE]-24" height="[JOGSIZE]-24"/>
      </cover>
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded" color="red" width="40" height="40" x="+0" y="+0"/>
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/>
        <on border_size="10" border="red" color="#33FF0000" shape="circle"/>
      </visual>
      <!-- <visual visibility="loaded ? constant 0.8 : constant 0.0"> -->
      <!-- <tooltip/> -->
      <!-- <pos x="+20" y="+54"/> -->
      <!-- <size width="[JOGSIZE]-40" height="[JOGSIZE]-56-56"/> -->
      <!-- <off shape="square" color="jogprogressoff" border="jogprogressoff" radius="6"/> -->
      <!-- <textzone class="text" x="+18" y="+50" width="[JOGSIZE]-36" height="46" fontsize="26" color="needle" align="center" weight="bold" textaction="var_equal '@$hauntingbpmhideopt' 1 ? get_text '==.==' : var_equal '@$hauntingjogbpmdgts' 0 ? get_text '%Pbpm' : var_equal '@$hauntingjogbpmdgts' 1 ? get_text '%Pbpmex'"/> -->
      <!-- </visual> -->
      <panel class="jogwheel_corner_buttons"/>
    </group>
    <!-- <scratch> -->
    <!-- <pos width="[JOGSIZE]" height="[JOGSIZE]"/> -->
    <!-- <mousecircle width="[JOGSIZE]" height="[JOGSIZE]"/> -->
    <!-- </scratch> -->
  </define>
  <define class="jogwheel_2" placeholders="*jogsize=165">
    <group name="jogwheel_a" visibility="var_equal '@$hauntingjogtype' 0">
      <visual novisibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
      </visual>
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
        <on shape="circle" color="knobfillon"/>
      </visual>
      <visual name="innercircle_border">
        <pos x="+7" y="+7"/>
        <size width="[JOGSIZE]-14" height="[JOGSIZE]-14"/>
        <off shape="circle" color="jogprogressoff" border_size="41" border="jogwheelbackground"/>
      </visual>
      <visual name="innercircle_border" visibility="loaded">
        <pos x="+59" y="+59"/>
        <size width="[JOGSIZE]-119" height="[JOGSIZE]-119"/>
        <off shape="circle" color="jogprogressoff" border_size="7" border="deckcolor"/>
      </visual>
      <visual name="innercircle_border">
        <pos x="+76" y="+76"/>
        <size width="[JOGSIZE]-152" height="[JOGSIZE]-152"/>
