      <!-- </visual> -->
      <!-- BUTTON -->
      <button x="+0" y="+0" action="stem_pad '[STEM]'" border_size="1">
        <size width="50" height="15"/>
        <off color="#222222" border="transparent" radius="3"/>
        <down color="#222222" border="transparent" radius="3"/>
        <selected color="#111111" border="transparent" radius="3"/>
        <text fontsize="10" color="#555555" colorselected="[COLOR]" colordown="[COLOR]" align="center" text="[LABEL]"/>
      </button>
      <!-- SIMPLE VECTOR VU METER -->
      <visual source="get_level '[STEM]'" type="linear" orientation="horizontal" direction="up" granularity="[GRANULARITY]">
        <pos x="+11" y="+40+15"/>
        <size width="30" height="3"/>
        <off shape="square" color="#333333" radius="1"/>
        <on shape="square" border="[COLOR]" color="[COLOR]" radius="1"/>
      </visual>
    </group>
  </define>
