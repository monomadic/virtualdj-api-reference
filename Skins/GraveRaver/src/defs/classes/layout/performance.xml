<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- These Performance layout shells are selected by @$hauntinglayout: 0 = two-deck / swap, 1 = full four-deck -->
  <define class="PERFORMANCE_MAIN_RACKS" placeholders="offset_y=0">
    <panel class="racks_extended" x="+2" y="[OFFSET_Y]" condition="var_equal '@$hide_main_waveforms' 0"/>
    <panel class="racks_single" x="+2" y="[OFFSET_Y]" condition="var_equal '@$hide_main_waveforms' 1"/>
  </define>
  <!-- Browser-zoom mini layouts can optionally keep rack surfaces visible.
       @$show_zoom_racks stays as the single runtime switch, while this
       helper keeps the layout shell from repeating that branch inline. -->
  <define class="PERFORMANCEMINI_RACKS" placeholders="vertical_y=0,mini_y=0">
    <group name="mini_racks_visible" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="racks_vertical" x="+2" y="[VERTICAL_Y]" condition="var_equal '@$hide_zoom_waveforms' 1"/>
      <panel class="racks_mini" x="+2" y="[MINI_Y]" condition="var_equal '@$hide_zoom_waveforms' 0"/>
    </group>
  </define>
  <define class="PERFORMANCE_2DECKS" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/performance-2decks.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="AREA_DECK_PERFORMANCE_SIDE" x="+2" panelname="deck1" deck="1" deckside="left" visibility="deck 1 leftdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_SIDE" x="+2" panelname="deck3" deck="3" deckside="left" visibility="deck 3 leftdeck"/>
    <!-- <panel class="AREA_DECK_PERFORMANCE_BODY" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/> -->
    <!-- <panel class="AREA_DECK_PERFORMANCE_BODY" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/> -->
    <group y="+60">
      <panel class="performance_main_racks"/>
    </group>
    <panel class="AREA_DECK_PERFORMANCE_SIDE" x="+1920-2-878-77-2" panelname="deck2" deck="2" deckside="right" visibility="deck 2 rightdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_SIDE" x="+1920-2-878-77-2" panelname="deck4" deck="4" deckside="right" visibility="deck 4 rightdeck"/>
    <!-- <panel class="AREA_DECK_PERFORMANCE_BODY" x="+1920-2-878-77-2" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/> -->
    <!-- <panel class="AREA_DECK_PERFORMANCE_BODY" x="+1920-2-878-77-2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/> -->
  </define>
  <define class="PERFORMANCE_2DECKS_VERTICAL" placeholders="*panelname">
    <panel class="AREA_DECK_PERFORMANCE_LEFT_VERTICAL" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_LEFT_VERTICAL" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="waveform_vertical" x="+2+800+2"/>
    <panel class="racks_vertical" x="+2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_VERTICAL" x="+1920-2-800" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_VERTICAL" x="+1920-2-800" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_2DECKS_CENTER" placeholders="*panelname">
    <panel class="AREA_DECK_PERFORMANCE_LEFT_CENTER" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_LEFT_CENTER" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="racks_vertical" x="+2"/>
    <panel class="waveform_horizontal_center" waveformwidth="474" waveformheight="333" x="+800-81+4" y="+0"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_CENTER" x="+1920-2-800+81" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_CENTER" x="+1920-2-800+81" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_4DECKS" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/performance-4decks.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="AREA_DECK_PERFORMANCE_BODY" x="+2" panelname="deck1" deck="1"/>
    <panel class="AREA_DECK_PERFORMANCE_BODY" x="+2" y="+264+2" panelname="deck3" deck="3"/>
    <panel class="performance_main_racks" offset_y="+264+2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT" x="+1920-2-878-77-2" panelname="deck2" deck="2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT" x="+1920-2-878-77-2" y="+264+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_4DECKS_VERTICAL" placeholders="*panelname">
    <panel class="AREA_DECK_PERFORMANCE_LEFT_CENTER" x="+2" panelname="deck1" deck="1"/>
    <panel class="AREA_DECK_PERFORMANCE_LEFT_CENTER" x="+2" y="+333+2" panelname="deck3" deck="3"/>
    <panel class="waveform_vertical4" x="+2+800+2-77-2"/>
    <panel class="racks_vertical" x="+2" y="+333+2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_CENTER" x="+1920-2-800+81" panelname="deck2" deck="2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_CENTER" x="+1920-2-800+81" y="+333+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_4DECKS_CENTER" placeholders="*panelname">
    <panel class="AREA_DECK_PERFORMANCE_LEFT_CENTER" x="+2" panelname="deck1" deck="1"/>
    <panel class="AREA_DECK_PERFORMANCE_LEFT_CENTER" x="+2" y="+333+2" panelname="deck3" deck="3"/>
    <panel class="waveform_horizontal_center4" waveformwidth="474" waveformheight="333+2+333" x="+800-81+4" y="+0"/>
    <panel class="racks_vertical" x="+2" y="+333+2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_CENTER" x="+1920-2-800+81" panelname="deck2" deck="2"/>
    <panel class="AREA_DECK_PERFORMANCE_RIGHT_CENTER" x="+1920-2-800+81" y="+333+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_2DECKS_MINI" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/performance-2decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="AREA_DECK_MINI" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="AREA_DECK_MINI" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="performancemini_racks" vertical_y="-235" mini_y="-235"/>
    <panel class="AREA_DECK_MINI" x="+1920-878-2" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="AREA_DECK_MINI" x="+1920-878-2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_4DECKS_MINI" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/performance-4decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="AREA_DECK_MINI" x="+2" panelname="deck1" deck="1"/>
    <panel class="AREA_DECK_MINI" x="+2" y="+98+2" panelname="deck3" deck="3"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="performancemini_racks" vertical_y="-235+98+2" mini_y="+50"/>
    <panel class="AREA_DECK_MINI" x="+1920-878-2" panelname="deck2" deck="2"/>
    <panel class="AREA_DECK_MINI" x="+1920-878-2" y="+98+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_DECKS_VERTICAL">
    <panel class="performance_2decks_vertical" y="+0" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks_vertical" y="+0" condition="var_equal '@$hauntinglayout' 1"/>
    <!-- browsers -->
    <group name="utility_bar_hidden" condition="var_equal '@$hauntingutilitybar' 0">
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+333+2" width="1920-4" height="1080-43-2-333-2-2" condition="var_equal '@$hauntinglayout' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$hauntingutilitybar' 1">
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+333+2" width="1920-4" height="1080-43-2-333-2-2-38" condition="var_equal '@$hauntinglayout' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2-38" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PERFORMANCE_DECKS_CENTER">
    <panel class="performance_2decks_center" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks_center" condition="var_equal '@$hauntinglayout' 1"/>
    <!-- browsers -->
    <group name="utility_bar_hidden" condition="var_equal '@$hauntingutilitybar' 0">
      <panel class="browser_overlay_with_racks" x="2" y="+333+2" width="1920-4" height="1080-43-2-333-2-2" condition="var_equal '@$hauntinglayout' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$hauntingutilitybar' 1">
      <panel class="browser_overlay_with_racks" x="2" y="+333+2" width="1920-4" height="1080-43-2-333-2-2-38" condition="var_equal '@$hauntinglayout' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2-38" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PERFORMANCE_DECKS_NO_WAVES">
    <panel class="performance_2decks" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks" condition="var_equal '@$hauntinglayout' 1"/>
    <!-- browsers -->
    <group name="utility_bar_hidden" condition="var_equal '@$hauntingutilitybar' 0">
      <panel class="browser_overlay_with_racks" y="+264+2" width="1920" height="1080-43-2-264-2-2" condition="var_equal '@$hauntinglayout' 0"/>
      <panel class="browser_overlay_with_racks" y="+264+2+264+2" width="1920" height="1080-43-2-264-2-2-264-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$hauntingutilitybar' 1">
      <panel class="browser_overlay_with_racks" y="+264+2" width="1920" height="1080-43-2-264-2-2-38" condition="var_equal '@$hauntinglayout' 0"/>
      <panel class="browser_overlay_with_racks" y="+264+2+264+2" width="1920" height="1080-43-2-264-2-2-264-2-38" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PERFORMANCEMINI_DECKS_NO_WAVES">
    <panel class="performance_2decks_mini" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks_mini" condition="var_equal '@$hauntinglayout' 1"/>
    <!-- browsers -->
    <group name="without_zoom_racks" condition="var_equal '@$show_zoom_racks' 0">
      <panel class="browser_overlay_plain" x="0" y="+43+100+2" width="1920" height="1080-43-2-100-2-38" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 1"/>
      <panel class="browser_overlay_plain" x="0" y="+43+100+2" width="1920" height="1080-43-2-100-2" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 0"/>
      <panel class="browser_overlay_plain" x="0" y="+43+100+2+98+2" width="1920" height="1080-43-2-100-2-98-2-38" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntingutilitybar' 1"/>
      <panel class="browser_overlay_plain" x="0" y="+43+100+2+98+2" width="1920" height="1080-43-2-100-2-98-2" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntingutilitybar' 0"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <group name="utility_bar_hidden" condition="var_equal '@$hauntingutilitybar' 0">
        <panel class="browser_overlay_with_racks" x="0" y="+98+2" width="1920" height="1080-43-2-98-2-2" condition="var_equal '@$hauntinglayout' 0"/>
        <panel class="browser_overlay_with_racks" x="0" y="+98+2+98+2" width="1920" height="1080-43-2-98-2-2-98-2" condition="var_equal '@$hauntinglayout' 1"/>
      </group>
      <group name="utility_bar_visible" condition="var_equal '@$hauntingutilitybar' 1">
        <panel class="browser_overlay_with_racks" x="0" y="+98+2" width="1920" height="1080-43-2-98-2-2-38" condition="var_equal '@$hauntinglayout' 0"/>
        <panel class="browser_overlay_with_racks" x="0" y="+98+2+98+2" width="1920" height="1080-43-2-98-2-2-98-2-38" condition="var_equal '@$hauntinglayout' 1"/>
      </group>
    </group>
  </define>
</defs>
