<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Top bar shell, mode utilities, status widgets, and app menus -->
  <define class="TOPBAR" placeholders="height=40,background=dark_0">
    <!-- Accent top line -->
    <line x="0" y="0" width="1920" height="1" highlight="dark_8" shadow="#00000000"/>
    <!-- SETTINGS MENU BUTTON -->
    <group name="applicationbuttons_logo" condition="is_mac">
      <logo>
        <pos x="+1920" y="-40"/>
        <size width="115" height="30"/>
      </logo>
      <menu tooltip="DIRECT OPTIONS">
        <pos x="+10" y="8"/>
        <size width="40" height="30"/>
        <off color="transparent" shape="square"/>
        <over color="transparent" shape="square"/>
        <selected color="button_background" shape="square"/>
        <text dx="+2" dy="+8" fontsize="25" text="iii" color="textoff" colorselected="needle" colorover="needle" orientation="vertical-cw"/>
        <item text="Keyboard Mode [CMD+B]" localize="true" action="toggle '@$dd_bordermode'" check="var_equal '@$dd_bordermode' 1"/>
        <separator/>
        <xi:include href="topbar/menu-items.xml" xpointer="xpointer(/menuitems/*)"/>
      </menu>
      <group visibility="false">
        <button action="close">
          <pos x="15" y="+13"/>
          <size width="17" height="17"/>
          <off shape="circle" color="#bf4744"/>
          <down shape="circle" color="#fc5753"/>
          <selected shape="circle" color="#fc5753"/>
        </button>
        <button action="minimize">
          <pos x="15+27" y="+13"/>
          <size width="17" height="17"/>
          <off shape="circle" color="#be8d2f"/>
          <down shape="circle" color="#fdbc40"/>
          <selected shape="circle" color="#fdbc40"/>
        </button>
        <button action="maximize">
          <pos x="15+27+27" y="+13"/>
          <size width="17" height="17"/>
          <off shape="circle" color="#279637"/>
          <down shape="circle" color="#33c748"/>
          <selected shape="circle" color="#33c748"/>
        </button>
      </group>
    </group>
