              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*6" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*7" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*8" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*9" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*10" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*11" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="orange_vu" radius="0" border="contrast" border_size="0"/>
            </led>
          </visual>
          <slider action="sampler_volume_master" dblclick="sampler_volume_master 80%" orientation="horizontal" direction="up" frommiddle="false">
            <pos x="+58+8" y="+4"/>
            <size width="70" height="20"/>
            <fader color="#999999" width="3" height="20"/>
          </slider>
          <button x="+3" y="+3" width="58" height="21" visibility="true" action="sampler_play_stop" query="get_level 'sampler' &amp; param_bigger 0.01">
            <off color="#333333" border="#000000" border_size="2" shape="square"/>
            <on color="#444444" border="#111111" border_size="2" shape="square"/>
            <over color="#444444" border="#000000" border_size="2" shape="square"/>
            <selected color="#555555" border="#0000FF" border_size="2" shape="square"/>
            <icon dx="-1" sysicon="play" width="24" height="24" color="#888888" colordown="white" colorselected="#888888"/>
