<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Master/microphone utility panels -->
  <define class="broadcast_panel">
    <textzone class="text" y="+0" width="77+77+2-6-6" height="20" fontsize="10" color="textoff" align="center" weight="" text="BROADCAST"/>
    <button class="button_main" tooltip="" x="+0" y="+24" width="72*2" height="60" textsize="11" textcolor="textoff2" textaction="broadcast_message 'full'" coloroff="xf_background" coloron="xf_background" bordersize="0"/>
    <button class="button_main" tooltip="" x="+0" y="+84" width="72" height="24" action="setting 'broadcastMode' 'direct'" textsize="11" textcolor="textdarker" textcoloron="needle" text="DIRECT" coloroff="xf_background" coloron="xf_background" bordersize="0"/>
    <button class="button_main" tooltip="" x="+72" y="+84" width="72" height="24" action="setting 'broadcastMode' 'video'" textsize="11" textcolor="textdarker" textcoloron="needle" text="VIDEO" coloroff="xf_background" coloron="xf_background" bordersize="0"/>
    <button class="button_main" tooltip="" x="+0" y="+84+24" width="72" height="24" action="setting 'broadcastMode' 'server'" textsize="11" textcolor="textdarker" textcoloron="needle" text="RADIO" coloroff="xf_background" coloron="xf_background" bordersize="0"/>
    <button class="button_main" tooltip="" x="+72" y="+84+24" width="72" height="24" action="setting 'broadcastMode' 'podcast'" textsize="11" textcolor="textdarker" textcoloron="needle" text="PODCAST" coloroff="xf_background" coloron="xf_background" bordersize="0"/>
    <button class="button_main" x="+0" y="+138" width="105" height="28" textsize="11" action="broadcast" text="START" coloroff="button_background2" coloron="br_focus" bordersize="0"/>
    <menu class="button_main" x="+60+4+30+30-10" y="+138" width="30" height="28" iconsize="22" sysicon="settings" coloron="br_focus" bordersize="0">
      <submenu text="Video Stream To">
        <item text="Facebook" action="setting 'broadcastVideoProvider' 0" check="setting 'broadcastVideoProvider' 0"/>
        <item text="Youtube" action="setting 'broadcastVideoProvider' 1" check="setting 'broadcastVideoProvider' 1"/>
        <item text="Periscope" action="setting 'broadcastVideoProvider' 2" check="setting 'broadcastVideoProvider' 2"/>
        <item text="Twitch" action="setting 'broadcastVideoProvider' 3" check="setting 'broadcastVideoProvider' 3"/>
        <item text="Vimeo" action="setting 'broadcastVideoProvider' 4" check="setting 'broadcastVideoProvider' 4"/>
        <item text="PlayDJ.tv" action="setting 'broadcastVideoProvider' 6" check="setting 'broadcastVideoProvider' 6"/>
        <item text="MixCloud" action="setting 'broadcastVideoProvider' 7" check="setting 'broadcastVideoProvider' 7"/>
        <item text="Other" action="setting 'broadcastVideoProvider' 5" check="setting 'broadcastVideoProvider' 5"/>
      </submenu>
      <submenu text="Direct Format">
        <item text="OGG" action="setting 'broadcastDirectFormat' ogg" check="setting 'broadcastDirectFormat' ogg"/>
        <item text="MP3" action="setting 'broadcastDirectFormat' mp3" check="setting 'broadcastDirectFormat' mp3"/>
      </submenu>
      <submenu text="Direct Quality">
        <item text="High" action="setting 'broadcastDirectQuality' high" check="setting 'broadcastDirectQuality' high"/>
        <item text="Mid" action="setting 'broadcastDirectQuality' medium" check="setting 'broadcastDirectQuality' medium"/>
        <item text="Low" action="setting 'broadcastDirectQuality' low" check="setting 'broadcastDirectQuality' low"/>
      </submenu>
      <submenu text="Video Quality">
        <item text="High" action="setting 'broadcastVideoQuality' high" check="setting 'broadcastVideoQuality' high"/>
        <item text="Mid" action="setting 'broadcastVideoQuality' mid" check="setting 'broadcastVideoQuality' mid"/>
        <item text="Low" action="setting 'broadcastVideoQuality' low" check="setting 'broadcastVideoQuality' low"/>
      </submenu>
      <separator/>
      <item text="Broadcast Song Info" action="setting 'broadcastSongInfo'" check="setting 'broadcastSongInfo'"/>
      <item text="Show Advanced Settings" action="settings 'broadcast'"/>
    </menu>
  </define>
  <define class="rec_panel">
    <textzone class="text" y="+0" width="77+77+2-6-6" height="20" fontsize="10" color="textoff" align="center" weight="" text="RECORD"/>
    <button class="button_main" tooltip="" x="+0" y="+24" width="72+72" height="24" query="record" textsize="11" textcolor="textdarker" textcoloron="needle" textaction="get_text '`get_record_time` (`get_record_size`)'" coloroff="xf_background" coloron="xf_background" bordersize="0"/>
    <button class="button_main" x="+0" y="+54" width="105" height="28" textsize="11" action="record" text="REC" coloroff="button_background2" coloron="br_focus" bordersize="0"/>
    <button class="button_main" x="+60+4+30+30-10" y="+54" width="30" height="28" action="record_config" iconsize="22" sysicon="settings" coloron="br_focus" bordersize="0"/>
  </define>
  <define class="MASTERFX_PANEL">
    <deck deck="master">
      <group name="sampler_panel" x="+0" y="+0">
        <textzone class="text" x="+0" y="+0" width="144" height="20" fontsize="10" color="textoff" align="center" weight="" text="SAMPLER"/>
        <button class="button_main" x="+0" y="+22" width="144" height="26" textsize="10" action="sampler_output 'headphones' ? sampler_output 'master' : sampler_output 'headphones'" textaction="sampler_output 'headphones' ? get_text 'SAMP -&gt; HEADPHONES' : get_text 'SAMP -&gt; MASTER'" rightclick="sampler_output 'popup'" color="`sampler_output 'headphones' ? '#00D5FF' : 'transparent'`"/>
        <group x="+0" y="+50">
          <button class="button_main" x="+0" y="+0" width="26" height="18" action="sampler_bank -1" iconsize="20" sysicon="arrowleft" coloroff="xf_background" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
          <button class="button_main" x="+0+26" y="+0" width="92" height="18" action="sampler_bank" rightclick="sampler_options" textaction="get_sampler_bank" coloroff="xf_background" coloron="knobfillon" bordersize="0" textsize="10" textcolor="textdarker" textcoloron="black"/>
          <button class="button_main" x="+0+26+92" y="+0" width="26" height="18" action="sampler_bank +1" iconsize="20" sysicon="arrowright" coloroff="xf_background" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
        </group>
        <group y="+75">
          <visual class="gfx_shape" width="144-26" height="22" coloroff="#000000" bordersize="0" bordercoloroff="#333333"/>
          <visual type="color" source="sampler_loaded 1 ? sampler_color [INDEX] : constant '#333333'">
            <pos x="+0" y="+0"/>
            <size width="4" height="22"/>
          </visual>
          <textzone class="text" x="+15" y="+0" width="100" height="22" fontsize="12" color="#AAAAAA" align="left" weight="" textaction="sampler_pad 1 &amp; param_uppercase"/>
          <button x="+144-22" y="+0" width="22" height="22" visibility="true" action="sampler_pad 1" query="sampler_play_stop 1">
            <off color="#000000" border="#000000" border_size="0" shape="square"/>
            <on color="#4444FF" border="#111111" border_size="0" shape="square"/>
            <over color="#444444" border="#000000" border_size="0" shape="square"/>
            <selected color="#5555FF" border="#0000FF" border_size="0" shape="square"/>
            <icon dx="-1" sysicon="play" width="24" height="24" color="#888888" colordown="white" colorselected="#FFFFFF"/>
          </button>
        </group>
        <group x="+0" y="+120">
          <visual class="gfx_shape" width="144" height="43-8-8" coloroff="xf_background"/>
          <textzone class="text" x="+0" y="+0" width="56" height="27" fontsize="10" color="textdarker" align="right" weight="" text="MASTER"/>
          <visual type="vumeter" source="get_level_left 'sampler'" x="+58+8" y="+6" width="70" height="6" smooth="no">
            <led x="+0" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*2" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*3" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*4" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
