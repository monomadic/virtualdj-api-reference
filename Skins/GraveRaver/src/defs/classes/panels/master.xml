        <button class="button_main" x="-71" y="+10" width="50" height="16" action="effect_select 1" coloroff="#111111" brcoloroff="#111111" coloron="magenta" brcoloron="magenta" textcoloroff="magenta" textcoloron="black" text="FX1" textsize="13"/>
      </group>
      <panel class="knob" x="-65" y="+36" textbelow="+40" knobsize="39" knobradius="9" faderradius="9" action="effect_slider 1" textaction="effect_select &amp; param_uppercase" rgclick="effect_select 1" frommiddle="false" fillcolor="magenta" fillcoloroff="#000000" text="FX1"/>
      <panel class="knob" x="-65" y="+110" textbelow="+40" knobsize="39" knobradius="9" faderradius="9" action="effect_slider 2" textaction="effect_select &amp; param_uppercase" rgclick="effect_select 2" frommiddle="false" fillcolor="#0055FF" fillcoloroff="#000000" text="FX2"/>
    </deck>
