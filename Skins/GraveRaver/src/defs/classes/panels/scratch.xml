<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Vertical scratch waveform helpers used by mixer and performance waveform layouts -->
  <define class="VERTICAL_SCRATCHWAVE" placeholders="deck">
    <deck deck="[DECK]">
      <visual x="+3" y="+15">
        <size width="92" height="350" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntinghidecrossfader' 0"/>
        <size width="92" height="350+55" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntinghidecrossfader' 1"/>
        <size width="92" height="350+216" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntinghidecrossfader' 0"/>
        <size width="92" height="350+216+30" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntinghidecrossfader' 1"/>
        <off shape="square" color="transparent" border_size="1" border="#202020" radius="0"/>
      </visual>
      <scratchwave orientation="vertical" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal">
        <pos x="+4" y="+15+2"/>
        <size width="90" height="370+195-4" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntinghidecrossfader' 0"/>
        <size width="90" height="370+195+30-4" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntinghidecrossfader' 1"/>
        <size width="90" height="350-4" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntinghidecrossfader' 0"/>
        <size width="90" height="400" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntinghidecrossfader' 1"/>
        <grid pos="-14" background="no" backgroundshaded="no" height="10" size="1" mainsize="2" phrasecolor="white" maincolor="white" color="darkgray" mirrored="true"/>
        <gridlines width="1" color="darkgray" transparency="0.5"/>
        <cue y="-10" height="6">
          <mask x="0" y="50" width="10" height="12"/>
          <text dx="+10" dy="-1" weight="" fontsize="12" important="true"/>
        </cue>
        <overlay>
          <pos x="+0" y="+160+11" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntinghidecrossfader' 0"/>
          <pos x="+0" y="+160+38" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntinghidecrossfader' 1"/>
          <pos x="+0" y="+279" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntinghidecrossfader' 0"/>
          <pos x="+0" y="+279+15" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntinghidecrossfader' 1"/>
          <size width="90" height="4"/>
          <background color="needle" shape="square"/>
        </overlay>
      </scratchwave>
      <textzone>
        <pos x="+2" y="+2"/>
        <size width="92" height="15"/>
        <text fontsize="9" weight="" color="#888888" align="center" format="`get_text '%Ppitch%'`" important="true"/>
      </textzone>
      <dropzone>
        <pos x="-14-2" y="+2"/>
        <size width="98+14+2+14+2" height="370+216+2" condition="var_equal '@$hauntinglayout' 1"/>
        <size width="98+14+2+14+2" height="370"/>
        <over color="transparent" border_size="2" border="deckcolor"/>
      </dropzone>
    </deck>
  </define>
  <define class="VERTICAL_SCRATCHWAVE2" placeholders="deck,outer_height,waveform_height,dropzone_height">
    <deck deck="[DECK]">
      <visual x="+3" y="+15">
        <size width="92" height="[OUTER_HEIGHT]"/>
        <off shape="square" color="transparent" border_size="1" border="#202020" radius="0"/>
      </visual>
      <scratchwave orientation="vertical" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal">
        <pos x="+4" y="+15+2"/>
        <size width="90" height="[WAVEFORM_HEIGHT]"/>
        <grid pos="-14" background="no" backgroundshaded="no" height="10" size="1" mainsize="2" phrasecolor="white" maincolor="white" color="darkgray" mirrored="true"/>
        <gridlines width="1" color="darkgray" transparency="0.5"/>
        <cue y="-10" height="6">
          <mask x="0" y="50" width="10" height="12"/>
          <text dx="+10" dy="-1" weight="" fontsize="12" important="true"/>
        </cue>
        <!-- <overlay> -->
        <!-- <pos x="+0" y="[OVERLAY_Y]"/> -->
        <!-- <size width="90" height="4"/> -->
        <!-- <background color="needle" shape="square"/> -->
        <!-- </overlay> -->
      </scratchwave>
      <textzone>
        <pos x="+2" y="+2"/>
        <size width="92" height="15"/>
        <text fontsize="9" weight="" color="#888888" align="center" format="`get_text '%Ppitch%'`" important="true"/>
      </textzone>
      <dropzone>
        <pos x="-14-2" y="+2"/>
        <size width="98+14+2+14+2" height="[DROPZONE_HEIGHT]"/>
        <over color="transparent" border_size="2" border="deckcolor"/>
      </dropzone>
    </deck>
  </define>
  <define class="vertical_scratchwave_prf" placeholders="deck,*width,*height">
    <deck deck="[DECK]">
      <scratchwave orientation="vertical" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="var_equal '@$hauntingwavesbkg' 0">
        <pos x="+0" y="+2"/>
        <size width="+[WIDTH]" height="+[HEIGHT]"/>
        <grid pos="-14" background="no" backgroundshaded="no" height="10" size="1" mainsize="5" maincolor="deckcolor" color="darkgray" mirrored="true"/>
        <gridlines width="1" color="darkgray" transparency="0.5"/>
        <cue y="-19" height="12">
          <mask x="0" y="0" width="12" height="12"/>
        </cue>
        <overlay>
          <pos x="-18" y="+[HEIGHT]/2"/>
          <size width="+[WIDTH]+18+18" height="2"/>
          <background color="needle" shape="square"/>
        </overlay>
      </scratchwave>
      <scratchwave orientation="vertical" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="var_equal '@$hauntingwavesbkg' 1">
        <pos x="+0" y="+2"/>
        <size width="+[WIDTH]" height="+[HEIGHT]"/>
        <grid pos="-14" background="yes" backgroundcolor="wavesbackgroundcolor" backgroundshaded="no" height="10" size="1" mainsize="5" maincolor="deckcolor" color="darkgray" mirrored="true"/>
        <gridlines width="1" color="darkgray" transparency="0.5"/>
        <cue y="-19" height="12">
          <mask x="0" y="0" width="12" height="12"/>
        </cue>
        <overlay>
          <pos x="-18" y="+[HEIGHT]/2"/>
          <size width="+[WIDTH]+18+18" height="2"/>
          <background color="needle" shape="square"/>
        </overlay>
      </scratchwave>
      <dropzone>
        <pos x="-14-2" y="+2"/>
        <size width="+[WIDTH]+14+2+14+2" height="+[HEIGHT]"/>
        <over color="transparent" border_size="2" border="deckcolor"/>
      </dropzone>
      <visual class="gfx_shape" y="+0" width="+[WIDTH]" height="22" coloroff="xf_progressbackground" visibility="loaded ? var_equal '@$hauntingbarcounter' 1 ? constant 0.96"/>
      <textzone visibility="loaded ? var_equal '@$hauntingbarcounter' 1">
        <pos x="-14" y="+0"/>
        <size width="+[WIDTH]+14+14" height="22"/>
        <text fontsize="15" weight="" color="needle" align="center" format="`get_bar`.`get_beat_num` bars" important="true"/>
      </textzone>
    </deck>
    <button class="button_main" x="960-13" y="+[HEIGHT]-26-32" width="26" height="26" action="repeat 100ms &amp; zoom_vertical -0.80%" text="+" weight="bold" textcoloron="needle" coloron="button_background" bordersize="0" textsize="18" visibility="0.7"/>
    <button class="button_main" x="960-13" y="+[HEIGHT]-26" width="26" height="26" action="repeat 100ms &amp; zoom_vertical +0.80%" text="-" weight="bold" textcoloron="needle" coloron="button_background" bordersize="0" textsize="20" visibility="0.7"/>
  </define>
</defs>
