    <panel class="area_waves" y="+43+2+99+2+98+2" condition="var_equal '@$hauntinglayout' 1"/>
    <panel class="performancemini_browser_waves"/>
  </define>
  <define class="PERFORMANCEMINI_BROWSER_WAVES">
    <group name="without_zoom_racks" condition="var_equal '@$show_zoom_racks' 0">
      <panel class="browser_overlay_plain_waves" x="0" y="+43+100+2" width="1920" height="1080-43-2-100-2" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 0"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+43+100+2" width="1920" height="1080-43-2-100-2-38" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 1"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+43+100+2+98+2" width="1920" height="1080-43-2-100-2-98-2" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntingutilitybar' 0"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+43+100+2+98+2" width="1920" height="1080-43-2-100-2-98-2-38" condition="var_equal '@$hauntinglayout' 1 ? var_equal '@$hauntingutilitybar' 1"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="browser_overlay_with_racks_waves" x="0" y="+98+2" width="1920" height="1080-43-2-98-2-2" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 0"/>
      <panel class="browser_overlay_with_racks_waves" x="0" y="+98+2" width="1920" height="1080-43-2-98-2-2-38" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 1"/>
