<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="PERFORMANCE_DECKS_ABOVE">
    <panel class="area_waves"/>
    <panel class="performance_2decks" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks" condition="var_equal '@$hauntinglayout' 1"/>
    <group name="utility_bar_hidden" condition="var_equal '@$hauntingutilitybar' 0">
      <browser class="browser_performance" height="1080-204-2-2-2-1" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="browser_performance_4decks" height="1080-204-2-2-2-1-264-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$hauntingutilitybar' 1">
      <browser class="browser_performance" height="1080-204-2-2-2-1-38" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="browser_performance_4decks" height="1080-204-2-2-2-1-264-2-38" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PERFORMANCEMINI_DECKS_ABOVE">
    <panel class="area_waves" y="+43+2"/>
    <panel class="performance_2decks_mini" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks_mini" condition="var_equal '@$hauntinglayout' 1"/>
    <panel class="performancemini_browser_waves"/>
  </define>
  <define class="PERFORMANCE_DECKS_BELOW">
    <panel class="performance_2decks" y="+0" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks" y="+0" condition="var_equal '@$hauntinglayout' 1"/>
    <panel class="area_waves" y="+2+324+3" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="area_waves" y="+2+324+3+264+2" condition="var_equal '@$hauntinglayout' 1"/>
