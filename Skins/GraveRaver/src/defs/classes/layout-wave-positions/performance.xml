      <browser class="browser_performance" height="1080-204-2-2-2-1" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="browser_performance_4decks" height="1080-204-2-2-2-1-264-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$hauntingutilitybar' 1">
      <browser class="browser_performance" height="1080-140" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="browser_performance_4decks" height="1080-440" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PERFORMANCEMINI_DECKS_BELOW">
    <panel class="performance_2decks_mini" y="+43+2" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="performance_4decks_mini" y="+43+2" condition="var_equal '@$hauntinglayout' 1"/>
