      <songpos class="songpos" x="+2+4" y="+68+4" width="800-4-8-81" height="44-4-8"/>
      <panel class="transport_center" x="+484+7+80-61-81+30" y="+188+108"/>
      <panel class="pitch_zone_vertical" x="+484+7-61+10-81+30" y="+108"/>
      <panel class="jogwheel_2" x="+800-[JOGSIZE]-2-8-20-14-61-81+15" y="+2+6+4+108"/>
      <line name="divider" color="button_background" width="2" height="171+48-2" x="+557-79-51-81+30+2" y="+108+2+2"/>
      <panel class="loops_center" x="+0" y="+108" panelname="[PANELNAME]"/>
      <panel class="pads_rack_center" x="+10" y="+108+72" panelname="[PANELNAME]"/>
      <panel class="channel_levels_vert" deck="[DECK]" x="+800-61-10-81" y="+108"/>
      <visual source="deck [DECK] leftdeck" visibility="var_equal '@$hauntinglayout' 1 ? loaded ? blink_play on : true">
        <size width="800-81" height="333"/>
        <down color="transparent" border_size="2" border="deckcolor" shape="square"/>
      </visual>
      <panel class="dual_dropzone" width="800-81" height="333"/>
    </deck>
  </define>

  <define class="AREA_DECK_PERFORMANCE_RIGHT" placeholders="deck,*panelname">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="878+77+2" height="264" coloroff="#111111" bordersize="1" bordercoloroff="#222222"/>
      <panel class="infos_ex" x="+0" deck="[DECK]" deckside="right"/>
      <visual class="gfx_shape" y="+68-2-6" width="878+77+2" height="38" coloroff="infos_background" bordercoloroff="panel_background" bordersize="2"/>
      <panel class="beat_divider_area" x="+2+4" y="+68+4-6" width="878-4-8+77+2" height="38-4-8"/>
      <songpos class="songpos" x="+2+4" y="+68+4-6" width="878-4-8+77+2" height="38-4-8"/>
      <panel class="transport_ex" x="+878-484-60-7-77-2+6+2" y="+103-6"/>
      <panel class="pitch_zone_ex" x="+878-484-60-7-77-2+77+2+2" y="+103-6"/>
      <panel class="jogwheel" x="+2+8+58+14+8+2-4" y="+2+6+4+103-6-4" name="jogwheel_spinner"/>
      <line name="divider" color="button_background" width="3" height="172-12" x="+878-557-3+77+1" y="+103+2-5"/>
      <panel class="loops_ex" x="+2+8+58+14+238+77+1" y="+103-6" panelname="[PANELNAME]"/>
      <panel class="channel_levels_ex" deck="[DECK]" x="+2+8" y="+103-6"/>
      <visual source="deck [DECK] select" visibility="var_equal '@$dd_bordermode' 1 ? deck [DECK] rightdeck ? var_equal '@$hauntinglayout' 1 ? loaded ? blink_play on : true">
        <size width="878+77+2" height="264"/>
        <down color="transparent" border_size="2" border="deckcolor" shape="square" radius="8"/>
      </visual>
      <dropzone visibility="var_equal '@$hauntinglayout' 0">
        <size width="878+77+2" height="264"/>
        <over color="transparent" border_size="2" border="deckcolor" shape="square"/>
      </dropzone>
      <dropzone visibility="var_equal '@$hauntinglayout' 1">
        <size width="878+77+2" height="264"/>
        <over color="transparent" border_size="2" border="needle" shape="square"/>
      </dropzone>
    </deck>
