  <define class="AREA_DECK_MINI" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <panel>
        <button class="button_main" action="select" rightclick="file_info" tooltip="Text Scroll\nRigth-click: Tag Editor" width="878" height="100-4" coloroff="infos_background" coloron="infos_background" brcoloroff="panel_background" brcoloron="panel_background" bordersize="2"/>
        <group visibility="loaded ? get_deck 1 ? true : get_deck 3 ? true : false">
          <button class="button_main" x="+0" y="+0" width="36" height="94" action="select" rightclick="cycle '@infospannelmode' 5" tooltip="Select Deck \n Rigth-click: Next Panel" coloroff="transparent" textcoloron="black" textcolor="deckcolor" textsize="33" textaction="get_deck" textheight="55" visibility="get_deck 1 ? true : get_deck 3 ? true : false"/>
          <menu class="menu_maindecks" query="select" x="+0" y="+64" width="40" height="20"/>
          <group x="+4+28+4+100" y="+0">
            <textzone tooltip="">
              <size width="478-50-8" height="34"/>
              <text fontsize="16" weight="bold" color="needle" align="left" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
            <textzone tooltip="">
              <pos y="+22"/>
              <size width="478-50-8" height="28"/>
              <text fontsize="12" weight="" color="#888888" align="left" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <cover rotate="no" rightclick="" dblclick="">
            <pos x="+2+4+33" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
          </cover>
          <button action="select" visibility="loaded">
            <pos x="+2+4+33" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
            <off shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
            <over shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
            <on shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
          </button>
          <button class="button_main" x="+878-10-90" y="+4" width="90" height="30" action="beat_tap" dblclick="reanalyze" rightclick="edit_bpm" coloroff="transparent" coloron="transparent" bordersize="0" textcolor="textdarker" textsize="18" textaction="not loaded ? get_text 'TAP'"/>
          <textzone class="text" x="+878-10-90" y="+4" width="90" height="30" fontsize="22" color="needle" align="center" weight="bold" textaction="var_equal '@$hauntingjogbpmdgts' 0 ? get_text '%Pbpm' : var_equal '@$hauntingjogbpmdgts' 1 ? get_text '%Pbpmex'"/>
          <textzone class="text" x="+878-10-90" y="+25" action="pitch_reset" width="90" height="30" fontsize="12" color="textoff2" align="center" weight="" textaction="get_text '%Ppitch%'"/>
