<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Performance layout shells, plus the shared mini deck strip used by Pro and Performance mini modes -->
  <define class="KNOB_SMALL_THIN" placeholders="*label,knob_color=white">
    <panel x="+0" y="+16">
      <slider action="effect_slider 'colorfx'" rightclick="effect_select 'colorfx'" dblclick="effect_slider 'colorfx' 50%" orientation="round" frommiddle="true" resettomiddle="true">
        <pos x="+15" y="+0"/>
        <size width="30" height="30"/>
        <fill width="30" height="30" radius="11" color="knobfillon" backcolor="#22FFFFFF"/>
        <fader color="[KNOB_COLOR]" width="3" height="12" radius="1" anglemin="-130" anglemax="130"/>
      </slider>
      <textzone action="effect_select colorfx">
        <pos x="+0" y="+29"/>
        <size width="59"/>
        <text fontsize="9" weight="" color="knobtextoff" align="center" action="[LABEL]" important="true" localize="true"/>
      </textzone>
    </panel>
  </define>

  <define class="KNOB_XSMALL_THIN" placeholders="*label,knob_color=#EEEEEE,fill_color=yellow,bg_color=#AAAAAA">
    <visual width="30" height="35">
      <off shape="square" color="#11FFFFFF" radius="0"/>
    </visual>
    <panel x="+5" y="+4">
      <slider orientation="round" frommiddle="true" resettomiddle="true" action="effect_slider 'colorfx'" rightclick="effect_select 'colorfx'" dblclick="effect_slider 'colorfx' 50%">
        <size width="20" height="20"/>
        <fader color="[KNOB_COLOR]" width="2" height="6" radius="1" anglemin="-140" anglemax="140"/>
        <fill width="15" height="20" radius="6" color="[FILL_COLOR]" backcolor="[BG_COLOR]"/>
        <clipmask x="984" y="3142"/>
      </slider>
      <textzone action="effect_select colorfx">
        <pos x="+0" y="+20"/>
        <size width="20"/>
        <text fontsize="7" weight="" color="knobtextoff" align="center" action="[LABEL]" important="true" localize="true"/>
      </textzone>
    </panel>
  </define>

  <define class="AREA_DECK_PERFORMANCE_SIDE" placeholders="*deck,*panelname,*deckside">
    <panel class="AREA_DECK_PERFORMANCE_SPINE" deck="[DECK]" panelname="[PANELNAME]" deckside="[DECKSIDE]" visibility="deck [DECK] leftdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_BODY" x="+35" deck="[DECK]" panelname="[PANELNAME]" deckside="[DECKSIDE]" visibility="deck [DECK] leftdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_SPINE" x="+960-35" deck="[DECK]" panelname="[PANELNAME]" deckside="[DECKSIDE]" visibility="deck [DECK] rightdeck"/>
    <panel class="AREA_DECK_PERFORMANCE_BODY" x="+2" deck="[DECK]" panelname="[PANELNAME]" deckside="[DECKSIDE]" visibility="deck [DECK] rightdeck"/>
    <panel visibility="var '@$debugui'">
      <visual width="320" height="20">
        <off shape="square" color="#AA000000" radius="0"/>
      </visual>
      <textzone>
        <size width="320" height="18"/>
        <text align="center" size="12" color="white" action="get_text 'DECK=`get_deck`([DECK]) SELECTED=`get_deck` GETLEFTDECK=`get_leftdeck` LEFTDECK=`leftdeck` LEFT=`deck [DECK] leftdeck`'"/>
      </textzone>
    </panel>
  </define>

  <define class="AREA_DECK_PERFORMANCE_SPINE" placeholders="*deck,*panelname,*deckside">
    <deck deck="[DECK]">
      <visual x="+0" y="+1" width="34" height="320">
        <off shape="square" color="black" radius="6"/>
      </visual>
      <button class="deck_button" deck="left" color="color_masterdeck">
        <pos x="+0" y="+0" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="-6" y="+0" condition="param_equal [DECKSIDE] 'right'"/>
        <text dx="+8" condition="param_equal [DECKSIDE] 'right'"/>
      </button>
      <menu class="menu_maindecks" query="select" x="+3" y="+295" width="28" height="20"/>
    </deck>
  </define>

  <!-- Shared performance body used on the left side and mirrored into the two-deck right-side shell -->
  <define class="AREA_DECK_PERFORMANCE_BODY" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="922" height="324" coloroff="panel_background" bordersize="1" bordercoloroff="#111111"/>
      <panel class="infos_ex" deckside="left" visibility="leftdeck"/>
      <panel class="infos_ex" deckside="right" visibility="rightdeck"/>
      <visual class="gfx_shape" y="+62" width="922" height="33" coloroff="#111111" bordercoloroff="#222222" bordersize="1"/>
      <songpos class="songpos" x="+2" y="+65" width="918" height="30"/>
      <songpos class="cuemap" x="+2" y="+91" width="918" height="2"/>
      <visual class="gfx_shape" x="+0" y="+0" width="922" height="324" coloroff="transparent" bordercoloroff="#444444" bordersize="1" radius="6"/>
      <visual class="gfx_shape" x="+9" y="+98" width="520" height="220" coloroff="#050505" bordersize="2" bordercoloroff="#222222" radius="10"/>
      <panel class="pad_page_selector_panel" x="+19" y="+100" panelname="[PANELNAME]"/>
      <group x="+620" y="+260">
        <panel class="KNOB_XSMALL_THIN" label="get_text 'KNOB'"/>
      </group>
      <group x="+535" y="+100">
        <group novisibility="setting 'eqMode' 'STEMS'" y="+4">
          <button class="dropdown_menu" action="eq_mode" x="+46" y="-4" visibility="var_equal '@$hauntingdropmenus' 0"/>
          <panel class="knob" x="+21" knobsize="21" knobradius="5" faderradius="0" textwidth="30" textcolor="white" textleft="-5" textbelow="+18" textsize="9" action="gain" rgclick="match_gain" dblclick="gain 50%" frommiddle="true" fillcolor="red" fillcoloroff="color_knob_bg" textaction="gain_label" actiontxt="var_equal '@$hauntingdropmenus' 1 ? eq_mode : eq_mode +1"/>
          <panel class="knob" x="+21" y="+50" knobsize="21" knobradius="5" faderradius="0" textwidth="30" textcolor="white" textleft="-5" textbelow="+18" textsize="9" action="eq_high" rgclick="eq_high 0% ? eq_high 50% : eq_high 0%" dblclick="eq_high 50%" frommiddle="true" fillcolor="colorvocal" fillcoloroff="colorvocal" textaction="high_label" actiontxt="eq_mode +1"/>
          <panel class="knob" x="+21" y="+50+40" knobsize="21" knobradius="5" faderradius="0" textwidth="30" textcolor="white" textleft="-5" textbelow="+18" textsize="9" action="eq_mid" rgclick="eq_mid 0% ? eq_mid 50% : eq_mid 0%" dblclick="eq_mid 50%" frommiddle="true" fillcolor="colorinstru" fillcoloroff="colorinstru" textaction="mid_label 'short'" actiontxt="eq_mode +1"/>
          <panel class="knob" x="+21" y="+50+40+40" knobsize="21" knobradius="5" faderradius="0" textwidth="30" textcolor="white" textleft="-5" textbelow="+18" textsize="9" action="eq_low" rgclick="eq_low 0% ? eq_low 50% : eq_low 0%" dblclick="eq_low 50%" frommiddle="true" fillcolor="colorbeat" fillcoloroff="colorbeat" textaction="low_label" actiontxt="eq_mode +1"/>
          <group x="+10" y="+50+40+40+50">
            <panel x="+9" class="knob" knobsize="25" knobradius="6" faderradius="0" textwidth="30" textcolor="white" textleft="-3" textbelow="+21" textsize="10" action="filter" dblclick="filter 50%" frommiddle="true" fillcolor="magenta" fillcoloroff="#884488" textaction="filter_label &amp; param_cast 'text' 9" actiontxt="filter_selectcolorfx"/>
            <visual type="transparent" source="effect_active colorfx ? blink 500ms">
              <pos x="+34" width="8" height="8"/>
              <off color="tab_menu" border="tab_menu" shape="circle"/>
              <on color="green" border="green" shape="circle"/>
            </visual>
          </group>
        </group>
        <group visibility="setting 'eqMode' 'STEMS'">
          <button class="dropdown_menu" action="eq_mode" x="+58" y="+6" visibility="var_equal '@$hauntingdropmenus' 0"/>
          <panel class="knob" x="+18" y="+14" knobsize="41" knobradius="10" faderradius="9" action="stem 'instru'" rgclick="stem 'instru' 0% ? stem 'instru' 50% : stem 'instru' 0%" dblclick="stem 'instru' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'INSTRU'" actiontxt="var_equal '@$hauntingdropmenus' 1 ? eq_mode : eq_mode +1"/>
          <panel class="knob" x="+18" y="+14+76" knobsize="41" knobradius="10" faderradius="9" action="stem 'hihat'" rgclick="stem 'hihat' 0% ? stem 'hihat' 50% : stem 'hihat' 0%" dblclick="stem 'hihat' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'HIHAT'" actiontxt="eq_mode +1"/>
          <panel class="knob" x="+18" y="+14+76+67" knobsize="41" knobradius="10" faderradius="9" action="stem 'vocal'" rgclick="stem 'vocal' 0% ? stem 'vocal' 50% : stem 'vocal' 0%" dblclick="stem 'vocal' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'VOCAL'" actiontxt="eq_mode +1"/>
          <panel class="knob" x="+18" y="+14+76+67+67" knobsize="41" knobradius="10" faderradius="9" action="stem 'kick'" rgclick="stem 'kick' 0% ? stem 'kick' 50% : stem 'kick' 0%" dblclick="stem 'kick' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'KICK'" actiontxt="eq_mode +1"/>
          <panel class="knob" x="+18" y="+14+81+68+68+68+13" knobsize="41" knobradius="10" faderradius="9" action="stem 'bass'" rgclick="stem 'bass' 0% ? stem 'bass' 50% : stem 'bass' 0%" dblclick="stem 'bass' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'BASS'" actiontxt="eq_mode +1"/>
        </group>
      </group>
      <group y="+10" x="-20">
        <panel class="jogwheel" x="+922-210" y="+2+6+4+103-6-4" name="jogwheel_spinner"/>
        <panel class="deck_level" deck="[DECK]" x="+922-30" y="+110"/>
      </group>
      <group x="+805" y="+290">
        <button class="button_main" textsize="11" width="110" height="30" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0">
          <off color="#000000" border="#333333" border_size="1" shape="square" radius="4" iconcolor="deckcolor"/>
          <over color="#111111" border="#666666" border_size="1" shape="square" radius="4"/>
          <down color="#111111" border="#888888" border_size="1" shape="square" radius="4"/>
          <selected color="deckcolor" border="deckcolor" radius="4" iconcolor="black"/>
        </button>
      </group>
      <visual source="select" x="-3" y="-3" visibility="var_equal '@$dd_bordermode' 1 ? deck [DECK] select">
        <size width="878+77+2-35+5" height="264+64"/>
        <down color="transparent" border_size="3" border="deckcolor" shape="square" radius="8"/>
      </visual>
      <panel x="+1" y="+1" class="dual_dropzone" width="878+77+2-35-2" height="264+60"/>
    </deck>
  </define>

  <define class="AREA_DECK_PERFORMANCE_LEFT_VERTICAL" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="766" height="333" coloroff="panel_background"/>
      <panel class="infos_vert"/>
      <visual class="gfx_shape" y="+68-2" width="766" height="44" coloroff="infos_background" bordercoloroff="panel_background" bordersize="2"/>
      <panel class="beat_divider_area" x="+2+4" y="+68+4" width="766-4-8" height="44-4-8"/>
      <songpos class="songpos" x="+2+4" y="+68+4" width="766-4-8" height="44-4-8"/>
      <panel class="transport_horizontal" x="+484+7+80-61" y="+188+108"/>
      <panel class="pitch_zone_vertical" x="+484+7-61+10" y="+108"/>
      <panel class="jogwheel_2" x="+800-[JOGSIZE]-2-8-20-14-61" y="+2+6+4+108"/>
      <line name="divider" color="button_background" width="3" height="171+48-2" x="+557-79-51" y="+108+2"/>
      <panel class="pads_rack_vert" x="+1" y="+108" panelname="[PANELNAME]"/>
      <panel class="channel_levels_vert" deck="[DECK]" x="+766-61-10" y="+108"/>
      <visual source="deck [DECK] leftdeck" visibility="var_equal '@$hauntinglayout' 1 ? loaded ? blink_play on : true">
        <size width="766" height="333"/>
        <down color="transparent" border_size="2" border="deckcolor" shape="square"/>
      </visual>
      <dropzone visibility="var_equal '@$hauntinglayout' 0">
        <size width="766" height="333"/>
        <over color="transparent" border_size="2" border="deckcolor" shape="square"/>
      </dropzone>
      <dropzone visibility="var_equal '@$hauntinglayout' 1">
        <size width="766" height="333"/>
        <over color="transparent" border_size="2" border="needle" shape="square"/>
      </dropzone>
    </deck>
  </define>

  <define class="AREA_DECK_PERFORMANCE_LEFT_CENTER" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="800-81" height="333" coloroff="panel_background"/>
      <panel class="infos_center"/>
      <visual class="gfx_shape" y="+68-2" width="800-81" height="44" coloroff="infos_background" bordercoloroff="panel_background" bordersize="2"/>
