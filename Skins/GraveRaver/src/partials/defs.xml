<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define color="bg" value="#101318"/>
  <define color="panel" value="#1B222B"/>
  <define color="panel_border" value="#313B47"/>
  <define color="text" value="#EEF3F7"/>
  <define color="muted" value="#9AA8B6"/>
  <define color="deck_left" value="#54C7EC" deck="1"/>
  <define color="deck_right" value="#FFB25F" deck="2"/>
  <define color="button" value="#252E38"/>
  <define color="button_text_on" value="#101318"/>

  <font name="Helvetica Neue"/>
  <nbdecks value="2"/>
  <tooltip size="13" color="text" back="panel" shortcut="muted" localize="true"/>
  <dialogs darkmode="true"/>

  <define class="label">
    <size width="260" height="18"/>
    <text fontsize="12" color="muted" weight="bold" align="left"/>
  </define>

  <define class="value">
    <size width="260" height="28"/>
    <text fontsize="22" color="text" weight="bold" align="left"/>
  </define>

  <define class="transport" placeholders="*text,*accent">
    <size width="112" height="40"/>
    <off shape="square" radius="6" color="button" border="[ACCENT]" border_size="2"/>
    <on shape="square" radius="6" color="[ACCENT]" border="[ACCENT]" border_size="2"/>
    <text fontsize="13" color="text" colorselected="button_text_on" weight="bold" align="center" text="[TEXT]"/>
  </define>
</defs>
