.DS_Store
__pycache__/
*.pyc

# Built plugin bundles (tools/plugin/build.sh). Source is tracked, output is not.
build/

# Atomix plugin SDK headers — third-party, deliberately NOT checked in.
# The headers carry "(c)Atomix Productions 2011-2018" with no license grant and
# no terms on the SDK download page, so this repo does not redistribute them.
# Fetch them yourself: https://www.virtualdj.com/wiki/PluginSDK8.html
# (VirtualDJ8_SDK_20211003.zip), or the community example set at
# https://github.com/szemek/virtualdj-plugins-examples
vendor/

# Decoded controllers.dat (device definitions, factory mappings, audio presets)
# — Atomix's own XML, vendor copyright, so never committed. `just controllers-vendor`
# regenerates it; tests/controllers-manifest.json holds the hashes it is checked
# against, and the corpus tools refuse a tree that disagrees with the manifest.
vendor/controllers/
