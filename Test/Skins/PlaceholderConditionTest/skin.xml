<?xml version="1.0" encoding="UTF-8"?>
<skin name="Reference Placeholder Condition Test" version="8" width="1040" height="620" nbdecks="2" author="Codex" breakline="620">
  <font name="Arial"/>

  <define color="bg" value="#10151B"/>
  <define color="panel" value="#18212A"/>
  <define color="border" value="#344251"/>
  <define color="text" value="#F1F5F8"/>
  <define color="muted" value="#AEB9C4"/>
  <define color="green" value="#1F8D5A"/>
  <define color="green_border" value="#3DDC84"/>
  <define color="amber" value="#A06A22"/>

  <define class="TEST_CELL" placeholders="*title,*detail">
    <square color="panel" border="border" border_size="1" radius="4">
      <pos x="+0" y="+0"/>
      <size width="300" height="82"/>
    </square>
    <textzone>
      <pos x="+14" y="+10"/>
      <size width="272" height="20"/>
      <text text="[TITLE]" color="text" fontsize="13" weight="bold" align="left"/>
    </textzone>
    <textzone>
      <pos x="+14" y="+34"/>
      <size width="272" height="30"/>
      <text text="[DETAIL]" color="muted" fontsize="10" align="left"/>
    </textzone>
    <square color="#202A34" border="#2E3A46" border_size="1" radius="3">
      <pos x="+184" y="+52"/>
      <size width="92" height="20"/>
    </square>
    <textzone>
      <pos x="+184" y="+56"/>
      <size width="92" height="12"/>
      <text text="no badge" color="muted" fontsize="9" align="center"/>
    </textzone>
  </define>

  <define class="TRUE_BADGE">
    <square color="green" border="green_border" border_size="1" radius="3">
      <pos x="+184" y="+52"/>
      <size width="92" height="20"/>
    </square>
    <textzone>
      <pos x="+184" y="+56"/>
      <size width="92" height="12"/>
      <text text="TRUE" color="text" fontsize="9" weight="bold" align="center"/>
    </textzone>
  </define>

  <define class="BOOL_VIS_INDICATOR" placeholders="*compact=false">
    <panel visibility="[COMPACT]">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="BOOL_COND_INDICATOR" placeholders="*compact=false">
    <panel condition="[COMPACT]">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="MODE_VIS_INDICATOR" placeholders="*mode=none">
    <panel visibility="param_equal '[MODE]' 'compact'">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="MODE_COND_INDICATOR" placeholders="*mode=none">
    <panel condition="param_equal '[MODE]' 'compact'">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="FLAG_EQUAL_INDICATOR" placeholders="*flag=0">
    <panel condition="param_equal [FLAG] 1">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="WIDTH_EQUAL_INDICATOR" placeholders="*width=420">
    <panel condition="param_equal [WIDTH] 420">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="WIDTH_SMALLER_INDICATOR" placeholders="*width=420">
    <panel condition="param_smaller [WIDTH] 500">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="WIDTH_CONSTANT_SMALLER_INDICATOR" placeholders="*width=420">
    <panel condition="constant [WIDTH] &amp; param_smaller 500">
      <panel class="true_badge"/>
    </panel>
  </define>

  <define class="SKIN_WIDTH_INDICATOR">
    <panel condition="skin_width &amp;&amp; param_bigger 0">
      <panel class="true_badge"/>
    </panel>
  </define>

  <panel name="background" visible="yes">
    <square color="bg">
      <pos x="0" y="0"/>
      <size width="1040" height="620"/>
    </square>
    <grabzone x="0" y="0" width="1040" height="42"/>
  </panel>

  <textzone>
    <pos x="40" y="28"/>
    <size width="800" height="28"/>
    <text text="Placeholder Condition Test" color="text" fontsize="24" weight="bold" align="left"/>
  </textzone>
  <textzone>
    <pos x="40" y="64"/>
    <size width="900" height="20"/>
    <text text="A green TRUE badge means VirtualDJ evaluated the expression as true for this skin load." color="muted" fontsize="12" align="left"/>
  </textzone>

  <panel class="test_cell" x="40" y="110"
         title="boolean visibility"
         detail="visibility=&quot;[COMPACT]&quot;, compact=true"/>
  <panel class="bool_vis_indicator" x="40" y="110" compact="true"/>

  <panel class="test_cell" x="370" y="110"
         title="boolean condition"
         detail="condition=&quot;[COMPACT]&quot;, compact=true"/>
  <panel class="bool_cond_indicator" x="370" y="110" compact="true"/>

  <panel class="test_cell" x="700" y="110"
         title="skin width control"
         detail="condition=&quot;skin_width &amp;&amp; param_bigger 0&quot;"/>
  <panel class="skin_width_indicator" x="700" y="110"/>

  <panel class="test_cell" x="40" y="220"
         title="string visibility"
         detail="visibility=&quot;param_equal '[MODE]' 'compact'&quot;"/>
  <panel class="mode_vis_indicator" x="40" y="220" mode="compact"/>

  <panel class="test_cell" x="370" y="220"
         title="string condition"
         detail="condition=&quot;param_equal '[MODE]' 'compact'&quot;"/>
  <panel class="mode_cond_indicator" x="370" y="220" mode="compact"/>

  <panel class="test_cell" x="700" y="220"
         title="numeric equality"
         detail="condition=&quot;param_equal [FLAG] 1&quot;, flag=1"/>
  <panel class="flag_equal_indicator" x="700" y="220" flag="1"/>

  <panel class="test_cell" x="40" y="330"
         title="width equality candidate"
         detail="condition=&quot;param_equal [WIDTH] 420&quot;, width=420"/>
  <panel class="width_equal_indicator" x="40" y="330" width="420"/>

  <panel class="test_cell" x="370" y="330"
         title="width smaller candidate"
         detail="condition=&quot;param_smaller [WIDTH] 500&quot;, width=420"/>
  <panel class="width_smaller_indicator" x="370" y="330" width="420"/>

  <panel class="test_cell" x="700" y="330"
         title="constant width candidate"
         detail="condition=&quot;constant [WIDTH] &amp; param_smaller 500&quot;"/>
  <panel class="width_constant_smaller_indicator" x="700" y="330" width="420"/>

  <square color="#151D25" border="border" border_size="1" radius="4">
    <pos x="40" y="456"/>
    <size width="960" height="96"/>
  </square>
  <textzone>
    <pos x="60" y="474"/>
    <size width="920" height="18"/>
    <text text="Literal constant display check" color="text" fontsize="14" weight="bold" align="left"/>
  </textzone>
  <textzone>
    <pos x="60" y="504"/>
    <size width="920" height="20"/>
    <text action="constant 'constant returned this text'" color="green_border" fontsize="14" weight="bold" align="left"/>
  </textzone>
  <textzone>
    <pos x="60" y="532"/>
    <size width="920" height="14"/>
    <text text="This fixture records behavior; it does not make the candidate expressions recommended patterns." color="muted" fontsize="10" align="left"/>
  </textzone>
</skin>
