<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference - Mix FX Query Test.xml
  Minimal local test page for current VirtualDJ Mix FX selection and active
  state queries.

  Test flow:
    1. Load this pad page.
    2. Press pad 5 to select FILTER, then compare pads 1 and 2.
    3. Press pad 6 to select ECHO, then compare pads 3 and 4.
    4. Press pad 7 to toggle Mix FX activation, then compare pads 7 and 8.
    5. Use shift pads 7 and 8 to log both active-state helpers.

  Selection-query result recorded in VirtualDJ 8.5.9307 / build 850.9336:
    - Direct query: effect_mixfx_select 'NAME' ? on : off
    - Indirect query: param_equal "`effect_mixfx_select`" "NAME" ? on : off
    - Both forms track the selected Mix FX in pad XML.

  `get_mixfx_active` is official but sparse as of the 2026-05-26 appendix
  refresh. Local pad text/query behavior is recorded in the tracker; repeat
  in skin/custom-button contexts before generalizing to those surfaces.
-->
<page name="MIX FX QUERY TEST">

  <pad1 name="FILTER?"
        color="effect_mixfx_select 'FILTER' ? color 'green' : color 'red'"
        query="effect_mixfx_select 'FILTER' ? on : off">
    effect_mixfx_select 'FILTER'
  </pad1>

  <pad2 name="FILT TXT?"
        color="param_equal &quot;`effect_mixfx_select`&quot; &quot;FILTER&quot; ? color 'green' : color 'red'"
        query="param_equal &quot;`effect_mixfx_select`&quot; &quot;FILTER&quot; ? on : off">
    effect_mixfx_select 'FILTER'
  </pad2>

  <pad3 name="ECHO?"
        color="effect_mixfx_select 'ECHO' ? color 'blue' : color 'red'"
        query="effect_mixfx_select 'ECHO' ? on : off">
    effect_mixfx_select 'ECHO'
  </pad3>

  <pad4 name="ECHO TXT?"
        color="param_equal &quot;`effect_mixfx_select`&quot; &quot;ECHO&quot; ? color 'blue' : color 'red'"
        query="param_equal &quot;`effect_mixfx_select`&quot; &quot;ECHO&quot; ? on : off">
    effect_mixfx_select 'ECHO'
  </pad4>

  <pad5 name="SET FILTER" color="color 'green'" query="effect_mixfx_select 'FILTER' ? on : off">
    effect_mixfx_select 'FILTER'
  </pad5>

  <pad6 name="SET ECHO" color="color 'blue'" query="effect_mixfx_select 'ECHO' ? on : off">
    effect_mixfx_select 'ECHO'
  </pad6>

  <pad7 name="FX ON/OFF" color="effect_mixfx_activate ? color 'orange' : color 'gray'" query="effect_mixfx_activate ? on : off">
    effect_mixfx_activate
  </pad7>

  <pad8 name="GET: `get_mixfx_active`"
        color="get_mixfx_active ? color 'green' : color 'red'"
        query="get_mixfx_active ? on : off">
    nothing
  </pad8>

  <shift_pad1 name="LOG FILTER?" color="color 'green'">debug `effect_mixfx_select 'FILTER'`</shift_pad1>
  <shift_pad2 name="LOG MIXFX" color="color 'green'">debug `effect_mixfx_select`</shift_pad2>
  <shift_pad3 name="LOG ECHO?" color="color 'blue'">debug `effect_mixfx_select 'ECHO'`</shift_pad3>
  <shift_pad4 name="LOG MIXFX" color="color 'blue'">debug `effect_mixfx_select`</shift_pad4>
  <shift_pad7 name="LOG ON/OFF" color="color 'orange'">debug `effect_mixfx_activate`</shift_pad7>
  <shift_pad8 name="LOG GET" color="color 'white'">debug `get_mixfx_active`</shift_pad8>

</page>
